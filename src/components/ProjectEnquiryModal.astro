---
interface Props {
  activePage?: string;
}

const { activePage = 'home' } = Astro.props;
const isContactPage = activePage === 'contact';
---

{!isContactPage && (
  <div
    id="project-enquiry-modal"
    class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/75 backdrop-blur-md opacity-0 pointer-events-none transition-all duration-500 overflow-y-auto"
    role="dialog"
    aria-modal="true"
    aria-labelledby="modal-title"
  >
    <!-- Background Click Backdrop overlay -->
    <div class="absolute inset-0" id="modal-backdrop-overlay"></div>

    <!-- Main Glassmorphism Modal Box -->
    <div
      id="project-modal-card"
      class="relative w-full max-w-xl bg-[#0D2E26] text-white rounded-3xl border border-white/15 p-6 sm:p-8 shadow-2xl overflow-hidden transform scale-95 transition-all duration-500 z-10 my-8"
    >
      <!-- Cyber Grid Overlay -->
      <div class="absolute inset-0 bg-[radial-gradient(#16A34A_1px,transparent_1px)] [background-size:20px_20px] opacity-15 pointer-events-none"></div>

      <!-- Glowing Ambient Orbs -->
      <div class="absolute -top-12 -right-12 w-64 h-64 bg-[#16A34A]/25 rounded-full blur-3xl pointer-events-none animate-pulse"></div>
      <div class="absolute -bottom-12 -left-12 w-64 h-64 bg-[#EAB308]/20 rounded-full blur-3xl pointer-events-none animate-pulse"></div>

      <!-- Close Button ('X') -->
      <button
        type="button"
        id="close-enquiry-modal-btn"
        aria-label="Close modal"
        class="absolute top-4 right-4 w-9 h-9 rounded-full bg-white/10 text-gray-300 hover:bg-white/20 hover:text-white flex items-center justify-center transition-colors z-20 cursor-pointer"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>

      <!-- Modal Header -->
      <div class="relative z-10 space-y-2 mb-5">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-500/20 text-emerald-300 text-xs font-semibold uppercase tracking-wider border border-emerald-500/30">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
          <span>Free Growth Consultation</span>
        </div>
        <h3 id="modal-title" class="text-2xl sm:text-3xl font-bold text-white tracking-tight leading-tight">
          Start Your <span class="text-emerald-400">Project Enquiry</span>
        </h3>
        <p class="text-xs sm:text-sm text-gray-300 leading-relaxed font-normal">
          Tell us about your business goals and get a customized growth strategy & roadmap within 24 hours.
        </p>
      </div>

      <!-- Form Container -->
      <div class="relative z-10" id="modal-form-wrapper">
        <form id="project-enquiry-form" action="/api/contact.php" method="POST" class="space-y-4">
          
          <!-- Full Name -->
          <div>
            <label for="modal-name" class="block text-xs sm:text-sm font-semibold uppercase tracking-wider text-gray-300 mb-1.5">
              Full Name *
            </label>
            <input
              type="text"
              id="modal-name"
              name="name"
              required
              placeholder="e.g. Rahul Sharma"
              class="w-full px-4 py-3.5 rounded-xl border border-gray-300/40 focus:border-emerald-400 focus:ring-2 focus:ring-emerald-400/20 outline-none text-base font-normal transition-all bg-white/10 text-white placeholder-gray-400"
            />
          </div>

          <!-- Phone & Email Grid -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
            <div>
              <label for="modal-phone" class="block text-xs sm:text-sm font-semibold uppercase tracking-wider text-gray-300 mb-1.5">
                Phone / WhatsApp *
              </label>
              <input
                type="tel"
                id="modal-phone"
                name="phone"
                required
                placeholder="+91 70014 63876"
                class="w-full px-4 py-3.5 rounded-xl border border-gray-300/40 focus:border-emerald-400 focus:ring-2 focus:ring-emerald-400/20 outline-none text-base font-normal transition-all bg-white/10 text-white placeholder-gray-400"
              />
            </div>

            <div>
              <label for="modal-email" class="block text-xs sm:text-sm font-semibold uppercase tracking-wider text-gray-300 mb-1.5">
                Email Address *
              </label>
              <input
                type="email"
                id="modal-email"
                name="email"
                required
                placeholder="hello@greviadigital.com"
                class="w-full px-4 py-3.5 rounded-xl border border-gray-300/40 focus:border-emerald-400 focus:ring-2 focus:ring-emerald-400/20 outline-none text-base font-normal transition-all bg-white/10 text-white placeholder-gray-400"
              />
            </div>
          </div>

          <!-- Service You Are Interested In (Multi-Select Dropdown) -->
          <div class="relative" id="modal-ms-wrapper">
            <label class="block text-xs sm:text-sm font-semibold uppercase tracking-wider text-gray-300 mb-1.5">
              Service You Are Interested In * <span class="text-xs text-emerald-400 font-medium lowercase">(select your requirement)</span>
            </label>
            <!-- Dropdown Trigger -->
            <button type="button" id="modal-ms-trigger"
              class="w-full px-4 py-3.5 rounded-xl border border-white/15 bg-white/5 text-left text-sm sm:text-base font-normal text-gray-300 flex items-center justify-between gap-2 transition-all focus:border-emerald-400 focus:ring-2 focus:ring-emerald-400/20 outline-none cursor-pointer hover:border-white/30">
              <span id="modal-ms-display" class="truncate">Select services...</span>
              <svg class="w-4 h-4 text-gray-400 shrink-0 transition-transform duration-200" id="modal-ms-arrow" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
              </svg>
            </button>
            <!-- Dropdown Panel -->
            <div id="modal-ms-panel" class="absolute z-50 top-full left-0 right-0 mt-1.5 bg-[#0A2E24] border border-white/15 rounded-xl shadow-xl p-2 space-y-1 hidden max-h-48 overflow-y-auto">
              <label class="flex items-center gap-2.5 p-2.5 rounded-lg hover:bg-emerald-500/10 cursor-pointer transition-all group">
                <input type="checkbox" name="services[]" value="Website Design" class="modal-ms-cb w-4 h-4 rounded accent-emerald-500 focus:ring-emerald-400 cursor-pointer" />
                <span class="text-xs sm:text-sm font-medium text-gray-200 group-hover:text-emerald-300">Website Design & Redesign</span>
              </label>
              <label class="flex items-center gap-2.5 p-2.5 rounded-lg hover:bg-emerald-500/10 cursor-pointer transition-all group">
                <input type="checkbox" name="services[]" value="SEO Services" class="modal-ms-cb w-4 h-4 rounded accent-emerald-500 focus:ring-emerald-400 cursor-pointer" />
                <span class="text-xs sm:text-sm font-medium text-gray-200 group-hover:text-emerald-300">SEO & Google Search Ranking</span>
              </label>
              <label class="flex items-center gap-2.5 p-2.5 rounded-lg hover:bg-emerald-500/10 cursor-pointer transition-all group">
                <input type="checkbox" name="services[]" value="Digital Marketing" class="modal-ms-cb w-4 h-4 rounded accent-emerald-500 focus:ring-emerald-400 cursor-pointer" />
                <span class="text-xs sm:text-sm font-medium text-gray-200 group-hover:text-emerald-300">Digital Marketing & Meta/Google Ads</span>
              </label>
              <label class="flex items-center gap-2.5 p-2.5 rounded-lg hover:bg-emerald-500/10 cursor-pointer transition-all group">
                <input type="checkbox" name="services[]" value="Direct Marketing" class="modal-ms-cb w-4 h-4 rounded accent-emerald-500 focus:ring-emerald-400 cursor-pointer" />
                <span class="text-xs sm:text-sm font-medium text-gray-200 group-hover:text-emerald-300">WhatsApp, SMS & Email Marketing</span>
              </label>
              <label class="flex items-center gap-2.5 p-2.5 rounded-lg hover:bg-emerald-500/10 cursor-pointer transition-all group">
                <input type="checkbox" name="services[]" value="AI Automation" class="modal-ms-cb w-4 h-4 rounded accent-emerald-500 focus:ring-emerald-400 cursor-pointer" />
                <span class="text-xs sm:text-sm font-medium text-gray-200 group-hover:text-emerald-300">AI Agent Setup & Automation</span>
              </label>
              <label class="flex items-center gap-2.5 p-2.5 rounded-lg hover:bg-emerald-500/10 cursor-pointer transition-all group">
                <input type="checkbox" name="services[]" value="Support & Maintenance" class="modal-ms-cb w-4 h-4 rounded accent-emerald-500 focus:ring-emerald-400 cursor-pointer" />
                <span class="text-xs sm:text-sm font-medium text-gray-200 group-hover:text-emerald-300">Support, Maintenance & Renewal</span>
              </label>
            </div>
          </div>

          <!-- Message -->
          <div>
            <label for="modal-message" class="block text-xs sm:text-sm font-semibold uppercase tracking-wider text-gray-300 mb-1.5">
              Tell Us About Your Project *
            </label>
            <textarea
              id="modal-message"
              name="message"
              rows="2"
              required
              placeholder="Briefly describe about your requirements or business goals..."
              class="w-full px-4 py-3.5 rounded-xl border border-gray-300/40 focus:border-emerald-400 focus:ring-2 focus:ring-emerald-400/20 outline-none text-base font-normal transition-all bg-white/10 text-white placeholder-gray-400 resize-y"
            ></textarea>
          </div>

          <!-- Terms & Conditions -->
          <label class="flex items-start gap-2.5 cursor-pointer group mt-2">
            <input type="checkbox" name="terms" required class="w-4 h-4 mt-0.5 rounded accent-emerald-500 cursor-pointer" />
            <span class="text-xs sm:text-sm text-gray-300 leading-relaxed font-normal">I accept the <a href="/terms" class="text-emerald-400 font-semibold underline hover:text-emerald-300">Terms & Conditions</a> and <a href="/privacy" class="text-emerald-400 font-semibold underline hover:text-emerald-300">Privacy Policy</a> *</span>
          </label>

          <!-- Submit Button -->
          <button
            type="submit"
            id="modal-submit-btn"
            class="w-full py-4 rounded-xl font-semibold text-base text-white bg-[#0F5A47] hover:bg-[#0A3E31] transition-all shadow-md hover:shadow-lg active:scale-95 text-center flex items-center justify-center gap-2 mt-2 cursor-pointer border border-emerald-400/30"
          >
            <span>Submit Project Enquiry</span>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
          </button>
        </form>
      </div>

      <!-- Success State Message (Initially Hidden) -->
      <div id="modal-success-state" class="relative z-10 hidden text-center py-8 space-y-4">
        <div class="w-16 h-16 rounded-full bg-emerald-500/20 text-emerald-400 border border-emerald-500/40 flex items-center justify-center text-3xl mx-auto shadow-inner">
          ✓
        </div>
        <p class="text-2xl font-extrabold text-white">Enquiry Received!</p>
        <p class="text-sm text-gray-300 max-w-sm mx-auto leading-relaxed">
          Thank you for reaching out. Our digital growth strategist will review your requirements and get back to you via WhatsApp or Email within 24 hours.
        </p>
        <button
          type="button"
          id="close-success-modal-btn"
          class="px-6 py-2.5 rounded-xl bg-white/10 text-white font-bold text-xs hover:bg-white/20 transition-colors cursor-pointer"
        >
          Close Window
        </button>
      </div>

    </div>
  </div>
)}

<script>
  function initProjectModalScript() {
    const modal = document.getElementById('project-enquiry-modal');
    const modalCard = document.getElementById('project-modal-card');
    const closeBtn = document.getElementById('close-enquiry-modal-btn');
    const backdropOverlay = document.getElementById('modal-backdrop-overlay');
    const enquiryForm = document.getElementById('project-enquiry-form') as HTMLFormElement | null;
    const formWrapper = document.getElementById('modal-form-wrapper');
    const successState = document.getElementById('modal-success-state');
    const closeSuccessBtn = document.getElementById('close-success-modal-btn');

    if (!modal || !modalCard) return;

    // Multi-select dropdown for modal
    (function() {
      const prefix = 'modal';
      const trigger = document.getElementById(prefix + '-ms-trigger');
      const panel = document.getElementById(prefix + '-ms-panel');
      const display = document.getElementById(prefix + '-ms-display');
      const arrow = document.getElementById(prefix + '-ms-arrow') as HTMLElement | null;
      const wrapper = document.getElementById(prefix + '-ms-wrapper');
      if (!trigger || !panel || !display || !arrow || !wrapper) return;
      const checkboxes = panel.querySelectorAll<HTMLInputElement>('.' + prefix + '-ms-cb');
      trigger.addEventListener('click', () => {
        const isOpen = !panel.classList.contains('hidden');
        panel.classList.toggle('hidden');
        arrow.style.transform = isOpen ? 'rotate(0deg)' : 'rotate(180deg)';
        if (!isOpen) trigger.classList.add('border-emerald-400', 'ring-2', 'ring-emerald-400/20');
        else trigger.classList.remove('border-emerald-400', 'ring-2', 'ring-emerald-400/20');
      });
      function updateDisplay() {
        if (!display) return;
        const selected: string[] = [];
        checkboxes.forEach((cb: HTMLInputElement) => {
          if (cb.checked) {
            const label = cb.parentElement?.querySelector('span')?.textContent?.trim();
            if (label) selected.push(label);
          }
        });
        if (selected.length === 0) {
          display.textContent = 'Select services...';
          display.classList.add('text-gray-400');
          display.classList.remove('text-gray-200');
        } else {
          display.textContent = selected.join(', ');
          display.classList.remove('text-gray-400');
          display.classList.add('text-gray-200');
        }
      }
      checkboxes.forEach(cb => cb.addEventListener('change', updateDisplay));
      document.addEventListener('click', (e) => {
        if (!wrapper.contains(e.target as Node)) {
          panel.classList.add('hidden');
          arrow.style.transform = 'rotate(0deg)';
          trigger.classList.remove('border-emerald-400', 'ring-2', 'ring-emerald-400/20');
        }
      });
    })();

    // Do NOT trigger on contact page
    const currentPath = window.location.pathname;
    if (currentPath.includes('/contact')) return;

    // Per-page session key so it triggers ONCE on EACH page visit
    const pageStorageKey = 'grevia_popup_dismissed_' + currentPath;

    // Open Modal Function
    function openModal() {
      if (!modal || !modalCard) return;
      modal.classList.remove('opacity-0', 'pointer-events-none');
      modal.classList.add('opacity-100', 'pointer-events-auto');
      modalCard.classList.remove('scale-95');
      modalCard.classList.add('scale-100');
    }

    // Close Modal Function
    function closeModal() {
      if (!modal || !modalCard) return;
      modal.classList.remove('opacity-100', 'pointer-events-auto');
      modal.classList.add('opacity-0', 'pointer-events-none');
      modalCard.classList.remove('scale-100');
      modalCard.classList.add('scale-95');
      // Mark as dismissed for THIS SPECIFIC PAGE in this session
      sessionStorage.setItem(pageStorageKey, 'true');
    }

    // 15-Second Delay Auto-Trigger for THIS PAGE
    const isPageDismissed = sessionStorage.getItem(pageStorageKey);
    if (!isPageDismissed) {
      setTimeout(() => {
        if (!sessionStorage.getItem(pageStorageKey)) {
          openModal();
        }
      }, 15000); // 15 seconds
    }

    // Event Listeners for Closing
    if (closeBtn) closeBtn.addEventListener('click', closeModal);
    if (backdropOverlay) backdropOverlay.addEventListener('click', closeModal);
    if (closeSuccessBtn) closeSuccessBtn.addEventListener('click', closeModal);

    // Escape Key Handler
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal.classList.contains('opacity-100')) {
        closeModal();
      }
    });

    // Form Submission Handler
    if (enquiryForm) {
      enquiryForm.addEventListener('submit', (e) => {
        e.preventDefault();
        
        // Mark page as dismissed
        sessionStorage.setItem(pageStorageKey, 'true');

        // Show success state
        if (formWrapper) formWrapper.classList.add('hidden');
        if (successState) successState.classList.remove('hidden');

        // Automatically close after 4 seconds of showing success
        setTimeout(() => {
          closeModal();
        }, 4000);
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initProjectModalScript);
  } else {
    initProjectModalScript();
  }
  document.addEventListener('astro:page-load', initProjectModalScript);
</script>
