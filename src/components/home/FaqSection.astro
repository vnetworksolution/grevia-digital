---
import { faqsData } from '../../data/faqs';
import siteConfig from '../../data/site.json';

const leftFaqs = faqsData.slice(0, 4);
const rightFaqs = faqsData.slice(4, 8);
---

<section class="py-20 bg-white border-y border-gray-100">
  <div class="container-1440 space-y-16">
    
    <!-- FAQ Header -->
    <div class="text-center space-y-4 max-w-3xl mx-auto">
      <div class="inline-flex items-center justify-center gap-2 px-4 py-1.5 rounded-full bg-[#0F5A47]/10 text-[#0F5A47] text-xs sm:text-sm font-semibold tracking-wide border border-[#0F5A47]/20">
        <span>Clear Answers</span>
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-gray-900 tracking-tight">
        Frequently Asked <span class="text-[#0F5A47]">Questions</span>
      </h2>
      <p class="text-gray-600 text-base sm:text-lg font-normal leading-relaxed">
        Everything you need to know about working with Grevia Digital.
      </p>
    </div>

    <!-- 2-Column Side-by-Side FAQ Grid (Final Design 1) -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 items-start">
      
      <!-- Left Column (4 FAQs) -->
      <div class="space-y-4">
        {leftFaqs.map((faq, index) => (
          <div class="bg-[#F9FAF6] rounded-2xl border border-gray-200/80 overflow-hidden transition-all duration-200 hover:border-[#0F5A47] hover:shadow-md">
            <button
              type="button"
              class="faq-button w-full px-6 py-5 text-left flex items-center justify-between gap-4 font-bold text-gray-900 text-base sm:text-lg hover:text-[#0F5A47] focus:outline-none cursor-pointer"
              aria-expanded="false"
              aria-controls={`faq-answer-left-${index}`}
              id={`faq-btn-left-${index}`}
            >
              <span>{faq.question}</span>
              <div class="w-8 h-8 rounded-full bg-white border border-gray-200 flex items-center justify-center text-[#0F5A47] shrink-0 transition-transform faq-icon">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"></path>
                </svg>
              </div>
            </button>
            
            <div
              id={`faq-answer-left-${index}`}
              role="region"
              aria-labelledby={`faq-btn-left-${index}`}
              class="faq-content hidden px-6 pb-6 text-sm sm:text-base text-gray-600 leading-relaxed border-t border-gray-200/40 pt-4 font-normal"
            >
              {faq.answer}
            </div>
          </div>
        ))}
      </div>

      <!-- Right Column (4 FAQs) -->
      <div class="space-y-4">
        {rightFaqs.map((faq, index) => (
          <div class="bg-[#F9FAF6] rounded-2xl border border-gray-200/80 overflow-hidden transition-all duration-200 hover:border-[#0F5A47] hover:shadow-md">
            <button
              type="button"
              class="faq-button w-full px-6 py-5 text-left flex items-center justify-between gap-4 font-bold text-gray-900 text-base sm:text-lg hover:text-[#0F5A47] focus:outline-none cursor-pointer"
              aria-expanded="false"
              aria-controls={`faq-answer-right-${index}`}
              id={`faq-btn-right-${index}`}
            >
              <span>{faq.question}</span>
              <div class="w-8 h-8 rounded-full bg-white border border-gray-200 flex items-center justify-center text-[#0F5A47] shrink-0 transition-transform faq-icon">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"></path>
                </svg>
              </div>
            </button>
            
            <div
              id={`faq-answer-right-${index}`}
              role="region"
              aria-labelledby={`faq-btn-right-${index}`}
              class="faq-content hidden px-6 pb-6 text-sm sm:text-base text-gray-600 leading-relaxed border-t border-gray-200/40 pt-4 font-normal"
            >
              {faq.answer}
            </div>
          </div>
        ))}
      </div>

    </div>

    <!-- Integrated Dark Green Banner Block Directly Under FAQs -->
    <div class="bg-gradient-to-br from-gray-900 via-[#0A3E31] to-[#0F5A47] rounded-3xl p-8 sm:p-12 text-white shadow-xl relative overflow-hidden">
      
      <!-- Radial background grid overlay -->
      <div class="absolute inset-0 bg-[radial-gradient(#16A34A_1px,transparent_1px)] [background-size:20px_20px] opacity-15 pointer-events-none"></div>

      <!-- Pulsing ambient glowing theme orbs -->
      <div class="absolute -top-24 -right-24 w-96 h-96 bg-[#EAB308]/20 rounded-full blur-3xl pointer-events-none animate-pulse"></div>
      <div class="absolute -bottom-24 -left-24 w-96 h-96 bg-[#16A34A]/25 rounded-full blur-3xl pointer-events-none animate-pulse"></div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center relative z-10">
        
        <div class="lg:col-span-8 space-y-4">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/10 text-emerald-400 text-xs font-semibold uppercase tracking-wider border border-white/10">
            <span>Ready For Growth? for your Business</span>
          </div>
          <h3 class="text-3xl sm:text-4xl font-bold text-white tracking-tight leading-tight">
            Your Next Customer May <span class="text-[#EAB308]">Already Be Searching.</span>
          </h3>
          <p class="text-gray-200 text-base sm:text-lg leading-relaxed font-normal">
            Don't let potential business go to your competitors. Let Grevia Digital build a high-performance website, strengthen your search visibility, and connect you with active buyers in Siliguri and beyond.
          </p>
        </div>

        <div class="lg:col-span-4 flex flex-col sm:flex-row lg:flex-col gap-3.5 sm:gap-4">
          <a
            href="/contact"
            class="inline-flex items-center justify-center px-6 py-3.5 sm:py-4 rounded-xl text-sm sm:text-base font-semibold text-gray-900 bg-[#EAB308] hover:bg-yellow-400 transition-colors shadow-md text-center w-full sm:w-auto lg:w-full"
          >
            <span>Consult With Us</span>
            <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
          </a>
          <a
            href={`tel:${siteConfig.contact.phone.replace(/[^0-9+]/g, '')}`}
            class="inline-flex items-center justify-center px-6 py-3.5 sm:py-4 rounded-xl text-sm sm:text-base font-semibold text-white bg-white/10 hover:bg-white/20 border border-white/20 transition-colors text-center w-full sm:w-auto lg:w-full"
          >
            <span>Call {siteConfig.contact.phone}</span>
          </a>
        </div>

      </div>

    </div>

  </div>
</section>

<script>
  // Accordion Click Logic
  document.querySelectorAll('.faq-button').forEach((btn) => {
    btn.addEventListener('click', () => {
      const isExpanded = btn.getAttribute('aria-expanded') === 'true';
      const targetId = btn.getAttribute('aria-controls');
      const targetContent = document.getElementById(targetId!);
      const icon = btn.querySelector('.faq-icon');

      btn.setAttribute('aria-expanded', (!isExpanded).toString());
      if (targetContent) {
        targetContent.classList.toggle('hidden');
      }
      if (icon) {
        icon.classList.toggle('rotate-180');
      }
    });
  });
</script>
