<!-- Auto-cycling script for Service AI Workflow steps -->
<script>
  function initServiceAiCycle() {
    const serviceAiCards = document.querySelectorAll('.service-ai-card');
    const stepIndicator = document.getElementById('service-ai-step-indicator');
    let currentServiceStep = 0;

    if (serviceAiCards.length > 0) {
      setInterval(() => {
        serviceAiCards.forEach((card, idx) => {
          if (idx === currentServiceStep) {
            card.className = 'service-ai-card p-4 sm:p-4.5 rounded-2xl bg-white/10 border border-emerald-400/60 shadow-xl transition-all duration-300 space-y-2 opacity-100 scale-[1.02]';
          } else {
            card.className = 'service-ai-card p-4 sm:p-4.5 rounded-2xl bg-black/30 border border-white/10 opacity-60 transition-all duration-300 space-y-2 scale-100';
          }
        });

        if (stepIndicator) {
          stepIndicator.textContent = `Step ${currentServiceStep + 1}/4`;
        }

        currentServiceStep = (currentServiceStep + 1) % serviceAiCards.length;
      }, 3000);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initServiceAiCycle);
  } else {
    initServiceAiCycle();
  }
</script>
