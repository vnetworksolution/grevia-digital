---
import themeConfig from '../../data/theme.json';
---

<section class="relative bg-gradient-to-b from-[#051813] via-[#07241C] to-[#0A3026] text-white pt-16 pb-28 md:pt-24 md:pb-36 lg:pt-28 lg:pb-40 overflow-hidden border-b border-emerald-500/15">
  
  <!-- AI Technology Background Video (Pixabay: artificial-intelligence-technology-203987) -->
  <video
    autoplay
    loop
    muted
    playsinline
    preload="auto"
    class="absolute inset-0 w-full h-full object-cover pointer-events-none opacity-40 mix-blend-screen scale-105"
  >
    <source src="/videos/hero-ai-bg.mp4" type="video/mp4" />
  </video>

  <!-- Deep Theme Color Overlay & Vignette (Guarantees Sharp Contrast & Brand Theme) -->
  <div class="absolute inset-0 bg-gradient-to-b from-[#051813]/80 via-[#07241C]/65 to-[#0A3026]/90 pointer-events-none"></div>

  <!-- Subtle High-Tech Radial Background Pattern -->
  <div class="absolute inset-0 bg-[radial-gradient(#16A34A_1px,transparent_1px)] [background-size:28px_28px] opacity-20 pointer-events-none"></div>

  <!-- Ambient Glowing Luxury Lighting Orbs (Inspired by Zelh & Modern Tech Studios) -->
  <div class="absolute top-0 right-1/4 w-[600px] h-[600px] bg-emerald-500/15 rounded-full blur-[140px] pointer-events-none animate-pulse"></div>
  <div class="absolute -bottom-24 left-10 w-[500px] h-[500px] bg-[#EAB308]/10 rounded-full blur-[120px] pointer-events-none"></div>
  <div class="absolute top-1/3 -left-32 w-80 h-80 bg-teal-500/15 rounded-full blur-[100px] pointer-events-none"></div>

  <div class="container-1440 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-10 xl:gap-12 items-center">
      
      <!-- Left Column: Copy & Actions (7 Cols) -->
      <div class="lg:col-span-7 space-y-8 text-left">
        
        <!-- Trust Badge Tag (Glowing pill with active radar ping) -->
        <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full bg-emerald-500/15 border border-emerald-500/30 text-emerald-300 text-xs sm:text-sm font-semibold tracking-wide backdrop-blur-md shadow-[0_0_20px_rgba(16,185,129,0.15)]">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-400"></span>
          </span>
          <span>{themeConfig.hero.badge}</span>
        </div>

        <!-- Main Original Headline (High Contrast White with Golden Glow Accent) -->
        <h1 class="text-4xl sm:text-5xl lg:text-[56px] font-bold text-white tracking-[-0.015em] leading-[1.18]">
          {themeConfig.hero.headlinePrefix} <span class="text-[#EAB308] underline decoration-emerald-400 decoration-4 underline-offset-8 drop-shadow-[0_2px_15px_rgba(234,179,8,0.25)]">{themeConfig.hero.headlineHighlight}</span>
        </h1>

        <!-- Supporting Paragraph (Legible & Crisp light gray) -->
        <p class="text-lg sm:text-xl text-gray-200 leading-relaxed font-normal max-w-2xl">
          {themeConfig.hero.paragraph}
        </p>

        <!-- CTA Action Buttons -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5 sm:gap-4 pt-2">
          <a
            href="/contact"
            class="inline-flex items-center justify-center px-8 py-4 rounded-xl text-base sm:text-lg font-semibold text-gray-950 bg-gradient-to-r from-[#EAB308] to-yellow-400 hover:from-yellow-400 hover:to-[#EAB308] shadow-xl shadow-yellow-500/25 hover:shadow-yellow-500/35 transition-all duration-200 active:scale-95 text-center w-full sm:w-auto"
          >
            <span>{themeConfig.hero.primaryCta}</span>
            <svg class="w-4 h-4 sm:w-5 sm:h-5 ml-2 sm:ml-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
          </a>

          <a
            href="/services"
            class="inline-flex items-center justify-center px-8 py-4 rounded-xl text-base sm:text-lg font-semibold text-white bg-white/[0.07] border border-white/20 hover:border-emerald-400 hover:bg-white/[0.12] transition-all duration-200 backdrop-blur-md shadow-md text-center w-full sm:w-auto group"
          >
            <span>{themeConfig.hero.secondaryCta}</span>
            <svg class="w-4 h-4 sm:w-5 sm:h-5 ml-2 text-gray-300 group-hover:text-emerald-300 group-hover:translate-x-1 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
          </a>
        </div>

        <!-- Trust Indicators Badges (Single Line Formatting with Luminous Icon Cards) -->
        <div class="pt-6 border-t border-white/15 grid grid-cols-2 sm:grid-cols-3 gap-6">
          <div class="flex items-center gap-3 whitespace-nowrap">
            <div class="p-2.5 rounded-xl bg-white/[0.08] text-emerald-400 border border-emerald-500/20 shrink-0">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
              </svg>
            </div>
            <div>
              <div class="text-2xl font-bold text-white whitespace-nowrap" data-counter-target="8" data-counter-suffix="+ Years">8+ Years</div>
              <div class="text-sm font-normal text-gray-300 whitespace-nowrap">Industry Experience</div>
            </div>
          </div>

          <div class="flex items-center gap-3 whitespace-nowrap">
            <div class="p-2.5 rounded-xl bg-white/[0.08] text-emerald-400 border border-emerald-500/20 shrink-0">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
            </div>
            <div>
              <div class="text-2xl font-bold text-white whitespace-nowrap" data-counter-target="100" data-counter-suffix="+ Projects">100+ Projects</div>
              <div class="text-sm font-normal text-gray-300 whitespace-nowrap">Work Completed</div>
            </div>
          </div>

          <div class="flex items-center gap-3 col-span-2 sm:col-span-1 whitespace-nowrap">
            <div class="p-2.5 rounded-xl bg-yellow-500/15 text-[#EAB308] border border-yellow-500/25 shrink-0">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
              </svg>
            </div>
            <div>
              <div class="text-2xl font-bold text-white whitespace-nowrap">Siliguri, WB</div>
              <div class="text-sm font-normal text-gray-300 whitespace-nowrap">Remote & Local</div>
            </div>
          </div>
        </div>

      </div>

      <!-- Right Column: Animated Border Image Frame & Bottom-Right Partner Pill (5 Cols) -->
      <div class="lg:col-span-5 relative flex justify-center lg:justify-end mt-8 sm:mt-10 lg:mt-0 pb-8 lg:pb-0">
        <div class="relative w-full max-w-[92%] xs:max-w-[420px] sm:max-w-[480px] md:max-w-[540px] lg:max-w-[460px] xl:max-w-[490px]">
          
          <!-- Image Frame with Floating Gentle Animation (Only image moves up and down) -->
          <div class="relative w-full animate-float-gentle">
            <!-- Background Atmospheric Glow Rings -->
            <div class="absolute -inset-4 bg-gradient-to-tr from-emerald-500/25 via-[#EAB308]/20 to-teal-400/20 rounded-[2.5rem] blur-2xl opacity-70 pointer-events-none"></div>

            <!-- Animated Rotating Gradient Border Frame -->
            <div class="relative p-[3px] rounded-[2rem] overflow-hidden shadow-[0_25px_60px_rgba(0,0,0,0.6)]">
              <!-- Continuous Spinning Conic Gradient Beam -->
              <div class="absolute -inset-[150%] animate-spin-slow bg-[conic-gradient(from_0deg,#16A34A,#EAB308,#0F5A47,#10B981,#EAB308,#16A34A)]"></div>

              <!-- Inner Image Container -->
              <div class="relative bg-gradient-to-b from-[#071F19] to-[#0A2E24] rounded-[calc(2rem-3px)] overflow-hidden">
                <img
                  src="/images/hero-consultant.jpg"
                  alt="Grevia Digital Growth Consultant - Digital Marketing & SEO Expert in Siliguri"
                  width="819"
                  height="1024"
                  fetchpriority="high"
                  decoding="async"
                  class="w-full h-auto object-cover object-top max-h-[660px] transition-transform duration-700 hover:scale-105"
                  loading="eager"
                />

                <!-- Bottom Vignette Shade for Depth -->
                <div class="absolute inset-0 bg-gradient-to-t from-[#071F19]/80 via-transparent to-transparent pointer-events-none"></div>
              </div>
            </div>
          </div>

          <!-- Floating Badge: Centered on bottom for responsive, bottom-right for desktop -->
          <div class="absolute -bottom-7 lg:-bottom-6 left-1/2 -translate-x-1/2 lg:left-auto lg:translate-x-0 lg:-right-6 z-20 group w-max max-w-[96%]">
            <!-- Ambient Golden Glow Halo behind badge -->
            <div class="absolute -inset-1 bg-gradient-to-r from-amber-400/40 via-yellow-300/30 to-emerald-400/30 rounded-3xl blur-lg opacity-70 group-hover:opacity-100 transition-opacity pointer-events-none"></div>

            <!-- Outer Animated Golden Rim -->
            <div class="relative p-[2px] rounded-[1.35rem] bg-gradient-to-r from-amber-300 via-yellow-400 to-amber-500 shadow-[0_20px_40px_rgba(0,0,0,0.45)]">
              
              <!-- Card Inner (Crisp White Luxury Surface) -->
              <div class="bg-white/95 backdrop-blur-xl px-4 py-3 sm:px-5 sm:py-3.5 rounded-[calc(1.35rem-2px)] flex items-center gap-3 sm:gap-3.5 transition-transform duration-300 group-hover:scale-[1.02]">
                
                <!-- Golden Verified Badge Icon -->
                <div class="w-9 h-9 sm:w-11 sm:h-11 lg:w-12 lg:h-12 rounded-xl bg-amber-400/20 text-[#CA8A04] flex items-center justify-center font-bold shrink-0 border border-amber-300/50 shadow-xs">
                  <svg class="w-5 h-5 sm:w-6 sm:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.3" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
                  </svg>
                </div>

                <!-- Text & Partner Brand Marks -->
                <div class="space-y-0.5">
                  <!-- Header Pill Label -->
                  <div class="flex items-center gap-1">
                    <span class="text-[11px] sm:text-xs font-mono font-bold uppercase tracking-wider text-[#B45309]">
                      Certified Partner
                    </span>
                  </div>

                  <!-- Google & Facebook Meta Brand Lockup (Clean, crisp, no-wrap scaling) -->
                  <div class="text-[13px] sm:text-[15px] font-extrabold text-gray-900 flex items-center gap-2 sm:gap-2.5 whitespace-nowrap">
                    <!-- Google Mark -->
                    <span class="flex items-center gap-1.5">
                      <svg class="w-4 h-4 sm:w-4.5 sm:h-4.5 inline shrink-0" viewBox="0 0 24 24">
                        <path fill="#4285F4" d="M23.745 12.27c0-.7-.06-1.4-.19-2.07H12v4.51h6.6c-.29 1.52-1.14 2.82-2.4 3.68v3.05h3.88c2.27-2.09 3.665-5.17 3.665-9.17z"/>
                        <path fill="#34A853" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.88-3.05c-1.08.72-2.45 1.16-4.05 1.16-3.12 0-5.77-2.1-6.72-4.93H1.25v3.15C3.26 21.36 7.33 24 12 24z"/>
                        <path fill="#FBBC05" d="M5.28 14.27A7.13 7.13 0 0 1 4.9 12c0-.79.14-1.57.38-2.27V6.58H1.25A11.96 11.96 0 0 0 0 12c0 1.92.45 3.74 1.25 5.42l4.03-3.15z"/>
                        <path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.33 0 3.26 2.64 1.25 6.58l4.03 3.15c.95-2.83 3.6-4.98 6.72-4.98z"/>
                      </svg>
                      <span>Google</span>
                    </span>

                    <span class="text-gray-300 font-normal">|</span>

                    <!-- Facebook Meta Mark -->
                    <span class="flex items-center gap-1.5 text-[#1877F2]">
                      <svg class="w-4 h-4 sm:w-4.5 sm:h-4.5 inline shrink-0" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                      </svg>
                      <span>Facebook Meta</span>
                    </span>
                  </div>

                </div>

              </div>
            </div>

          </div>

        </div>
      </div>

    </div>
  </div>
</section>

<script>
  // Animated Counter Function for Metrics (Slower 2.5s duration)
  function initCounters() {
    const counterElements = document.querySelectorAll('[data-counter-target]');
    if (!counterElements.length) return;

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const el = entry.target as HTMLElement;
          const targetNum = parseInt(el.getAttribute('data-counter-target') || '0', 10);
          const suffix = el.getAttribute('data-counter-suffix') || '+';
          const duration = 2500; // 2.5 seconds
          let startTime: number | null = null;

          function animateCounter(timestamp: number) {
            if (!startTime) startTime = timestamp;
            const elapsed = timestamp - startTime;
            const progress = Math.min(elapsed / duration, 1);
            const easeProgress = 1 - Math.pow(1 - progress, 2);
            const current = Math.floor(easeProgress * targetNum);

            el.textContent = current + suffix;

            if (progress < 1) {
              requestAnimationFrame(animateCounter);
            } else {
              el.textContent = targetNum + suffix;
            }
          }

          requestAnimationFrame(animateCounter);
          observer.unobserve(el);
        }
      });
    }, { threshold: 0.1 });

    counterElements.forEach((el) => observer.observe(el));
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCounters);
  } else {
    initCounters();
  }
</script>
