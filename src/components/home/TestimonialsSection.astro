---
import { testimonialsData } from '../../data/testimonials';
---

<section id="reviews" class="py-20 bg-[#F9FAF6] border-y border-gray-200/60 overflow-hidden relative">
  <!-- Subtle Dot Grid Texture Overlay -->
  <div class="absolute inset-0 pointer-events-none opacity-40 bg-[radial-gradient(#0F5A47_0.8px,transparent_0.8px)] [background-size:24px_24px]"></div>

  <div class="container-1440 space-y-10 relative z-10">

    <!-- 2-Part Split Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Left Column: Title, Description, Trust Badges & Controls (5 Cols) -->
      <div class="lg:col-span-5 space-y-6">
        
        <div class="inline-flex items-center justify-center gap-2 px-4 py-1.5 rounded-full bg-[#0F5A47]/10 text-[#0F5A47] text-xs sm:text-sm font-semibold tracking-wide border border-[#0F5A47]/20">
          <span>Client Feedback</span>
        </div>
        
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-gray-900 tracking-tight leading-tight">
          What Our Clients Say <br class="hidden sm:inline" />
          <span class="text-[#0F5A47]">About Grevia Digital</span>
        </h2>
        
        <p class="text-gray-600 text-base sm:text-lg leading-relaxed font-normal">
          Read real client experiences across website design, search engine optimization, and digital marketing campaigns in Siliguri and beyond.
        </p>

        <!-- Genuine & Verified Client Reviews Badge (Design 1 Final) -->
        <div class="p-5 rounded-2xl bg-gradient-to-br from-amber-50 via-white to-emerald-50 border border-amber-400/50 shadow-md flex flex-col gap-3 max-w-sm relative overflow-hidden">
          <div class="absolute -right-8 -top-8 w-24 h-24 bg-amber-400/20 rounded-full blur-xl"></div>
          <div class="flex items-center justify-between relative z-10">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#EAB308]/20 text-yellow-800 text-xs font-semibold uppercase tracking-wider border border-[#EAB308]/40">
              <svg class="w-4 h-4 text-[#EAB308]" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 1.944A11.954 11.954 0 012.166 5C2.056 5.649 2 6.319 2 7c0 5.225 3.34 9.67 8 11.317C14.66 16.67 18 12.225 18 7c0-.681-.056-1.35-.166-2A11.954 11.954 0 0110 1.944zM11 14a1 1 0 11-2 0 1 1 0 012 0zm0-7a1 1 0 10-2 0v4a1 1 0 102 0V7z" clip-rule="evenodd"/>
              </svg>
              <span>Genuine & Verified Client Reviews</span>
            </div>
          </div>
          <div class="flex items-center gap-3 pt-2 border-t border-amber-200/60 relative z-10">
            <div class="flex items-center text-yellow-400 gap-1">
              {[...Array(5)].map(() => (
                <svg class="w-5 h-5 fill-current drop-shadow-xs" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
                </svg>
              ))}
            </div>
            <span class="text-xs sm:text-sm font-semibold text-gray-900">5.0 Star Rating • 12 Verified</span>
          </div>
        </div>

        <!-- Carousel Arrow Navigation Buttons -->
        <div class="pt-2 flex items-center gap-3">
          <button
            type="button"
            id="testimonial-prev"
            class="w-12 h-12 rounded-xl bg-white border-2 border-gray-200 text-[#0F5A47] hover:bg-[#0F5A47] hover:text-white hover:border-[#0F5A47] transition-all shadow-sm flex items-center justify-center focus:outline-none cursor-pointer"
            aria-label="Previous Review"
          >
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"></path>
            </svg>
          </button>

          <button
            type="button"
            id="testimonial-next"
            class="w-12 h-12 rounded-xl bg-white border-2 border-gray-200 text-[#0F5A47] hover:bg-[#0F5A47] hover:text-white hover:border-[#0F5A47] transition-all shadow-sm flex items-center justify-center focus:outline-none cursor-pointer"
            aria-label="Next Review"
          >
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"></path>
            </svg>
          </button>
        </div>

      </div>

      <!-- Right Column: Horizontal Animated Carousel Track (7 Cols) -->
      <div class="lg:col-span-7 relative">
        <div class="relative overflow-hidden -mx-2 py-2">
          <div id="testimonial-track" class="flex transition-transform duration-500 ease-out">
            {testimonialsData.map((review) => (
              <div class="testimonial-slide w-full md:w-1/2 shrink-0 px-2">
                
                <!-- Review Card -->
                <div class="bg-white p-7 sm:p-8 rounded-3xl border border-gray-200/90 shadow-sm hover:shadow-xl hover:border-[#0F5A47] transition-all duration-300 flex flex-col justify-between space-y-6 h-full">
                  
                  <div class="space-y-4">
                    <!-- Top Row: Rating Stars Left + Verified Badge Right -->
                    <div class="flex items-center justify-between">
                      <div class="flex text-yellow-400 gap-1">
                        {[...Array(review.rating)].map(() => (
                          <svg class="w-5 h-5 fill-current" viewBox="0 0 20 20">
                            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
                          </svg>
                        ))}
                      </div>

                      <span class="text-xs font-medium uppercase tracking-wider text-emerald-800 bg-emerald-50 px-3 py-1 rounded-full border border-emerald-200 shrink-0">
                        Verified Review
                      </span>
                    </div>

                    <!-- Review Text -->
                    <p class="text-base sm:text-lg text-gray-700 leading-relaxed font-normal italic">
                      "{review.reviewText}"
                    </p>
                  </div>

                  <!-- Client Name, Tag & Person Icon Positioned to the Left -->
                  <div class="pt-5 border-t border-gray-100 flex items-center justify-start gap-3.5 text-left">
                    <div class="w-10 h-10 rounded-full bg-[#0F5A47]/10 text-[#0F5A47] flex items-center justify-center shrink-0">
                      <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                        <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                      </svg>
                    </div>
                    <div class="flex flex-col items-start space-y-0.5">
                      <h3 class="text-base sm:text-lg font-bold text-gray-900 leading-snug">
                        {review.clientName}
                      </h3>
                      {review.tag && (
                        <span class="text-xs sm:text-sm font-medium text-[#0F5A47]">
                          {review.tag}
                        </span>
                      )}
                    </div>
                  </div>

                </div>

              </div>
            ))}
          </div>
        </div>

        <!-- Dot Indicators -->
        <div id="testimonial-dots" class="flex items-center justify-center lg:justify-start gap-2.5 mt-6"></div>
      </div>

    </div>

  </div>
</section>

<script>
  // Testimonial Carousel Script
  const track = document.getElementById('testimonial-track') as HTMLElement | null;
  const prevBtn = document.getElementById('testimonial-prev') as HTMLElement | null;
  const nextBtn = document.getElementById('testimonial-next') as HTMLElement | null;
  const dotsContainer = document.getElementById('testimonial-dots') as HTMLElement | null;
  const slides = document.querySelectorAll('.testimonial-slide');

  if (track && prevBtn && nextBtn && dotsContainer && slides.length > 0) {
    let currentIndex = 0;

    function getVisibleSlides() {
      if (window.innerWidth >= 768) return 2;
      return 1;
    }

    function getMaxIndex() {
      const visible = getVisibleSlides();
      return Math.max(0, slides.length - visible);
    }

    function renderDots() {
      if (!dotsContainer) return;
      dotsContainer.innerHTML = '';
      const maxIndex = getMaxIndex();
      for (let i = 0; i <= maxIndex; i++) {
        const dot = document.createElement('button');
        dot.type = 'button';
        dot.ariaLabel = `Go to slide ${i + 1}`;
        dot.className = `w-3 h-3 rounded-full transition-all duration-200 cursor-pointer ${
          i === currentIndex ? 'bg-[#0F5A47] w-8' : 'bg-gray-300 hover:bg-gray-400'
        }`;
        dot.addEventListener('click', () => {
          currentIndex = i;
          updateSlider();
        });
        dotsContainer.appendChild(dot);
      }
    }

    function updateSlider() {
      if (!track || !dotsContainer) return;
      const slide = slides[0] as HTMLElement;
      const slideWidth = slide.getBoundingClientRect().width;
      const moveAmount = slideWidth * currentIndex;
      
      track.style.transform = `translateX(-${moveAmount}px)`;

      const dots = dotsContainer.querySelectorAll('button');
      dots.forEach((dot, idx) => {
        if (idx === currentIndex) {
          dot.className = 'w-8 h-3 rounded-full bg-[#0F5A47] transition-all duration-200 cursor-pointer';
        } else {
          dot.className = 'w-3 h-3 rounded-full bg-gray-300 hover:bg-gray-400 transition-all duration-200 cursor-pointer';
        }
      });
    }

    prevBtn.addEventListener('click', () => {
      if (currentIndex > 0) {
        currentIndex--;
      } else {
        currentIndex = getMaxIndex();
      }
      updateSlider();
    });

    nextBtn.addEventListener('click', () => {
      if (currentIndex < getMaxIndex()) {
        currentIndex++;
      } else {
        currentIndex = 0;
      }
      updateSlider();
    });

    window.addEventListener('resize', () => {
      if (currentIndex > getMaxIndex()) {
        currentIndex = getMaxIndex();
      }
      renderDots();
      updateSlider();
    });

    renderDots();
    updateSlider();
  }
</script>
