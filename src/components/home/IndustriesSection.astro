---

<section id="industries-section" class="py-20 sm:py-24 bg-gradient-to-b from-white via-[#EEF4F0] to-[#DCE8E0] relative overflow-hidden">
  <!-- Soft ambient aesthetic glow spots without dots -->
  <div class="absolute -top-32 -left-32 w-96 h-96 bg-emerald-200/30 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute top-1/2 -right-32 w-[28rem] h-[28rem] bg-amber-100/35 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute -bottom-24 left-1/3 w-96 h-96 bg-teal-100/35 rounded-full blur-3xl pointer-events-none"></div>

  <div class="container-1440 relative z-10">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto space-y-4 mb-14">
      <div class="inline-flex items-center justify-center gap-2 px-4 py-1.5 rounded-full bg-[#0F5A47]/10 text-[#0F5A47] text-xs sm:text-sm font-semibold tracking-wide border border-[#0F5A47]/20">
        <span>Diverse Sector Expertise</span>
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-gray-900 tracking-tight leading-tight">
        Industries <span class="text-[#0F5A47]">We Serve</span>
      </h2>
      <p class="text-gray-600 text-base sm:text-lg leading-relaxed">
        Different business sectors require tailored digital strategies. We adapt our web design, SEO, and marketing campaigns to suit your specific industry dynamics.
      </p>
    </div>

    <!-- Interactive WOW Industry Cards Grid (2 cols mobile, 3 tablet, 5 desktop) -->
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-3.5 sm:gap-6">
      {industriesList.map((item) => (
        <div class="relative p-4 sm:p-6 rounded-2xl border border-white/10 shadow-lg hover:shadow-2xl hover:border-emerald-400/50 hover:-translate-y-1.5 transition-all duration-500 flex flex-col justify-end min-h-[220px] sm:min-h-[260px] group cursor-pointer text-white overflow-hidden isolate select-none">
          
          <!-- Pexels Stock Photo Background with Dynamic Cinematic Scale & Filter -->
          <img
            src={item.image}
            alt={item.name}
            loading="lazy"
            decoding="async"
            class="absolute inset-0 w-full h-full object-cover -z-20 filter brightness-75 contrast-105 group-hover:scale-115 group-hover:brightness-90 transition-all duration-700 ease-out"
          />

          <!-- Multi-stage Dark Gradient Backdrop -->
          <div class="absolute inset-0 bg-gradient-to-t from-gray-950 via-gray-950/75 to-transparent -z-10 group-hover:from-black group-hover:via-[#062c22]/90 group-hover:to-transparent transition-all duration-500"></div>

          <!-- Top Glowing Accent Line on Hover -->
          <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-transparent via-[#EAB308] to-emerald-400 transform -translate-x-full group-hover:translate-x-0 transition-transform duration-700 ease-out"></div>

          <!-- Card Content with Interactive Slide Transitions -->
          <div class="relative z-10 flex flex-col justify-end space-y-2.5">
            
            <!-- Icon Badge (Floats up on hover) -->
            <div class="w-10 h-10 sm:w-11 sm:h-11 rounded-xl bg-white/10 backdrop-blur-md text-[#EAB308] border border-white/20 flex items-center justify-center font-bold text-lg group-hover:bg-[#EAB308] group-hover:text-gray-950 group-hover:border-[#EAB308] group-hover:scale-110 group-hover:rotate-3 transition-all duration-300 shadow-md shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d={item.icon}></path>
              </svg>
            </div>

            <!-- Title -->
            <div class="transform transition-transform duration-300 ease-out">
              <h3 class="text-sm sm:text-base font-extrabold text-white group-hover:text-[#EAB308] transition-colors leading-snug drop-shadow-md">
                {item.name}
              </h3>
            </div>

            <!-- Benefit Description: Slides in with smooth reveal, always pure white on hover -->
            <div class="grid grid-rows-[0fr] group-hover:grid-rows-[1fr] sm:grid-rows-[1fr] transition-all duration-500 ease-out">
              <div class="overflow-hidden">
                <p class="text-xs text-gray-300 pt-2 border-t border-white/15 font-normal leading-relaxed group-hover:text-white transition-colors">
                  {item.benefit}
                </p>
                <!-- Interactive Action Pill Linking directly to Services Page -->
                <a
                  href="/services"
                  class="pt-2.5 inline-flex items-center gap-1.5 text-[11px] font-semibold text-[#EAB308] hover:text-yellow-300 opacity-0 group-hover:opacity-100 -translate-y-1 group-hover:translate-y-0 transition-all duration-300 cursor-pointer"
                >
                  <span>Explore Solutions</span>
                  <svg class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"></path>
                  </svg>
                </a>
              </div>
            </div>

          </div>

        </div>
      ))}
    </div>

  </div>
</section>
