---
const highlights = [
  {
    title: "8+ Years Experience",
    desc: "Eight years of practical digital agency experience building high-performing web platforms and marketing strategies."
  },
  {
    title: "100+ Projects Completed",
    desc: "Over 100 successful projects delivered across hotels, travel agencies, healthcare, local services, and corporate brands."
  },
  {
    title: "Siliguri Based - Digital Agency",
    desc: "Rooted in Siliguri, West Bengal with full remote capability to partner seamlessly with clients anywhere in India and globally."
  },
  {
    title: "Modern AI Approach",
    desc: "Integrating cutting-edge AI workflows to accelerate web creation, optimize search intent, and deliver smart digital solutions."
  },
  {
    title: "Dedicated Support 24x7",
    desc: "Reliable, responsive ongoing assistance ensuring your website and campaigns run smoothly without downtime."
  },
  {
    title: "Direct Communication",
    desc: "No confusing agency middlemen. You work directly with experienced digital strategists who understand your goals."
  }
];
---

<section id="why-choose-us" class="py-20 bg-white">
  <div class="container-1440">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Left Column (5 Cols) -->
      <div class="lg:col-span-5 space-y-6">
        <div class="inline-flex items-center justify-center gap-2 px-4 py-1.5 rounded-full bg-[#0F5A47]/10 text-[#0F5A47] text-xs sm:text-sm font-semibold tracking-wide border border-[#0F5A47]/20">
          <span>Proven Track Record</span>
        </div>
        <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 tracking-tight leading-tight">
          Why Businesses Work With <span class="text-[#0F5A47]">Grevia Digital</span>
        </h2>
        <p class="text-gray-600 text-base sm:text-lg leading-relaxed font-normal">
          We don't sell generic promises or shiny vanity metrics. We focus strictly on building solid digital foundations that help your business reach customers, build authority, and generate enquiries.
        </p>

        <div class="pt-2 flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5 sm:gap-4">
          <a
            href="/contact"
            class="inline-flex items-center justify-center px-7 py-3.5 rounded-xl text-base font-semibold text-white bg-[#0F5A47] hover:bg-[#0A3E31] transition-all duration-200 shadow-md hover:shadow-lg active:scale-95 text-center w-full sm:w-auto"
          >
            <span>Start Your Project</span>
            <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
          </a>

          <a
            href="/about"
            class="inline-flex items-center justify-center px-7 py-3.5 rounded-xl text-base font-semibold text-gray-800 bg-white border-2 border-gray-200 hover:border-[#0F5A47] hover:text-[#0F5A47] transition-all duration-200 shadow-xs hover:shadow-md text-center w-full sm:w-auto"
          >
            <span>Know About Us</span>
            <svg class="w-4 h-4 ml-2 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
          </a>
        </div>

        <!-- Clean Minimal Certified Partner Bar (Matching Service Page - Centered on Mobile/Responsive) -->
        <div class="pt-8 sm:pt-10 space-y-2.5 flex flex-col items-center lg:items-start text-center lg:text-left">
          <!-- Certified Partner Label -->
          <div class="flex items-center justify-center lg:justify-start gap-1.5 w-full">
            <span class="text-sm sm:text-base font-mono font-bold uppercase tracking-wider text-[#B45309]">
              Certified Partner
            </span>
          </div>

          <!-- Google & Facebook Meta & Semrush Brands Placed Below (Centered on responsive) -->
          <div class="flex flex-wrap items-center justify-center lg:justify-start gap-x-4 gap-y-2 text-base sm:text-lg font-extrabold text-gray-900 pt-0.5">
            <!-- Google Mark -->
            <span class="inline-flex items-center gap-2.5">
              <svg class="w-6 h-6 inline shrink-0" viewBox="0 0 24 24">
                <path fill="#4285F4" d="M23.745 12.27c0-.7-.06-1.4-.19-2.07H12v4.51h6.6c-.29 1.52-1.14 2.82-2.4 3.68v3.05h3.88c2.27-2.09 3.665-5.17 3.665-9.17z"/>
                <path fill="#34A853" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.88-3.05c-1.08.72-2.45 1.16-4.05 1.16-3.12 0-5.77-2.1-6.72-4.93H1.25v3.15C3.26 21.36 7.33 24 12 24z"/>
                <path fill="#FBBC05" d="M5.28 14.27A7.13 7.13 0 0 1 4.9 12c0-.79.14-1.57.38-2.27V6.58H1.25A11.96 11.96 0 0 0 0 12c0 1.92.45 3.74 1.25 5.42l4.03-3.15z"/>
                <path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.33 0 3.26 2.64 1.25 6.58l4.03 3.15c.95-2.83 3.6-4.98 6.72-4.98z"/>
              </svg>
              <span>Google</span>
            </span>

            <span class="text-gray-300 font-normal">|</span>

            <!-- Facebook Meta Mark -->
            <span class="inline-flex items-center gap-2.5 text-[#1877F2]">
              <svg class="w-6 h-6 inline shrink-0" fill="currentColor" viewBox="0 0 24 24">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
              </svg>
              <span>Facebook Meta</span>
            </span>

            <span class="text-gray-300 font-normal">|</span>

            <!-- Semrush Mark -->
            <span class="inline-flex items-center gap-2.5 text-[#FF652D]">
              <svg class="w-6 h-6 inline shrink-0" fill="currentColor" viewBox="0 0 24 24">
                <path d="M20.698 11.911c0 .444-.226.516-.79.516-.596 0-.706-.1-.77-.554-.118-1.152-.896-2.13-2.201-2.24-.418-.034-.518-.19-.518-.706 0-.48.074-.708.446-.708 2.265.01 3.833 1.832 3.833 3.69v.002zm3.3 0c0-3.456-2.338-7.11-7.74-7.11H5.52c-.218 0-.354.11-.354.31 0 .109.082.209.156.26.388.31.97.654 1.73 1.036.743.372 1.323.616 1.903.852.246.1.336.208.336.344 0 .19-.136.308-.4.308H.372c-.254 0-.372.164-.372.326 0 .136.044.254.162.372.69.726 1.796 1.596 3.4 2.604 1.466.91 2.98 1.74 4.533 2.492.236.11.308.236.308.372-.008.154-.126.28-.4.28H4.1c-.216 0-.344.12-.344.3 0 .1.08.226.19.326.888.808 2.311 1.688 4.207 2.494 2.53 1.08 5.094 1.721 7.98 1.721 5.465 0 7.867-4.087 7.867-7.289l-.002.002zm-7.133 5.104c-2.794 0-5.132-2.276-5.132-5.114 0-2.794 2.33-5.04 5.132-5.04 2.863 0 5.111 2.24 5.111 5.04a5.086 5.086 0 0 1-5.111 5.114z"/>
              </svg>
              <span>Semrush</span>
            </span>
          </div>
        </div>
      </div>

      <!-- Right Column: Highlight Grid (7 Cols) -->
      <div class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-6">
        {highlights.map((item) => (
          <div class="p-6 rounded-2xl bg-[#F9FAF6] border border-gray-200/80 space-y-2 hover:border-[#0F5A47] transition-all duration-300 shadow-xs group">
            <div class="w-8 h-8 rounded-xl bg-[#0F5A47]/10 text-[#0F5A47] flex items-center justify-center font-bold text-sm mb-3 group-hover:bg-[#0F5A47] group-hover:text-white transition-colors duration-300">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
              </svg>
            </div>
            <h3 class="text-lg font-bold text-gray-900 group-hover:text-[#0F5A47] transition-colors">{item.title}</h3>
            <p class="text-sm text-gray-600 leading-relaxed font-normal">{item.desc}</p>
          </div>
        ))}
      </div>

    </div>
  </div>
</section>
