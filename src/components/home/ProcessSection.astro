---
const processSteps = [
  {
    num: "01",
    title: "Tell Us What You Need",
    description: "Reach out via our form, WhatsApp, or phone. We discuss your business goals, timeline, and growth targets."
  },
  {
    num: "02",
    title: "We Understand Your Business",
    description: "We analyze your target market, local search competitors, customer profiles, and current digital presence."
  },
  {
    num: "03",
    title: "We Build the Strategy",
    description: "We construct a tailored blueprint combining high-speed web design, local SEO mapping, and campaign funnels."
  },
  {
    num: "04",
    title: "We Create and Launch",
    description: "We execute custom website design, write strategic copy, configure technical SEO, and launch campaign assets."
  },
  {
    num: "05",
    title: "We Improve and Grow",
    description: "We monitor performance metrics, tune ad campaigns, and scale your search engine visibility continuously."
  }
];
---

<section id="process-contact" class="py-16 sm:py-20 bg-gradient-to-b from-[#DCE8E0] via-[#EEF4F0] to-white relative overflow-hidden">
  <!-- Soft continuous transition backdrop glows without dots -->
  <div class="absolute top-0 right-1/4 w-[32rem] h-80 bg-emerald-100/35 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute bottom-10 -left-20 w-96 h-96 bg-amber-100/30 rounded-full blur-3xl pointer-events-none"></div>

  <div class="container-1440 relative z-10">
    
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto space-y-3 mb-12 sm:mb-14">
      <div class="inline-flex items-center justify-center gap-2 px-4 py-1.5 rounded-full bg-[#0F5A47]/10 text-[#0F5A47] text-xs sm:text-sm font-semibold tracking-wide border border-[#0F5A47]/20">
        <span>Work Process & Direct Enquiry</span>
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-gray-900 tracking-tight">
        How We Work <span class="text-[#0F5A47]">Together</span>
      </h2>
      <p class="text-gray-600 text-base sm:text-lg leading-relaxed font-normal">
        Working with Grevia Digital is straightforward. Explore our 5-step growth journey and submit your project enquiry directly.
      </p>
    </div>

    <!-- 2-Column Split Layout (Vertically Centered & Aligned) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
      
      <!-- Left Column: Clean Borderless Vertical Timeline (6 Cols - Centered to match form height) -->
      <div class="lg:col-span-6 flex flex-col justify-center my-auto py-2">

        <!-- Timeline Container (1 to 5) -->
        <div class="space-y-7 sm:space-y-8 py-1">
          {processSteps.map((step, idx) => (
            <div class="relative flex items-start gap-4 sm:gap-5 group cursor-default">
              
              <!-- Segment Line Container (Rendered ONLY between 01 and 05; NEVER above 01, NEVER below 05) -->
              {idx < processSteps.length - 1 && (
                <div class="absolute left-5 top-10 bottom-0 -translate-x-1/2 w-0.5 bg-[#0F5A47]/30 pointer-events-none h-full"></div>
              )}

              <!-- Number Circle (Highlights to Yellow on Hover) -->
              <div class="relative z-10 w-10 h-10 rounded-full bg-[#0F5A47] text-white font-bold text-sm flex items-center justify-center shrink-0 shadow-md transition-all duration-300 group-hover:bg-[#EAB308] group-hover:text-gray-900 group-hover:scale-125 group-hover:shadow-xl group-hover:ring-4 group-hover:ring-yellow-500/20">
                {step.num}
              </div>

              <!-- Step Content -->
              <div class="space-y-1.5 pt-0.5">
                <h3 class="text-lg font-bold text-gray-900 group-hover:text-[#0F5A47] transition-colors leading-snug">
                  {step.title}
                </h3>
                <p class="text-sm sm:text-[15px] text-gray-600 leading-relaxed font-normal">
                  {step.description}
                </p>
              </div>

            </div>
          ))}
        </div>

      </div>

      <!-- Right Column: Direct Contact Form (6 Cols - Matching Height) -->
      <div class="lg:col-span-6 flex">
        <div class="bg-white rounded-3xl p-8 sm:p-9 border border-gray-200/90 shadow-md flex flex-col justify-between w-full relative overflow-hidden">
          <div class="absolute top-0 left-0 right-0 h-2 bg-[#0F5A47]"></div>

          <div class="space-y-2 mb-6">
            <h3 class="text-2xl font-bold text-gray-900">
              Start Your Project Enquiry
            </h3>
            <p class="text-sm text-gray-600 font-normal">
              Fill out this quick form and our team will get back to you within 24 hours.
            </p>
          </div>

          <form action="/api/contact.php" method="POST" class="space-y-5 flex-grow flex flex-col justify-between">
            
            <div class="space-y-4">
              <div>
                <label for="proc-name" class="block text-xs sm:text-sm font-semibold uppercase tracking-wider text-gray-700 mb-1.5">
                  Full Name *
                </label>
                <input
                  type="text"
                  id="proc-name"
                  name="name"
                  required
                  placeholder="e.g. Rahul Sharma"
                  class="w-full px-4 py-3.5 rounded-xl border border-gray-300 focus:border-[#0F5A47] focus:ring-2 focus:ring-[#0F5A47]/20 outline-none text-base font-normal transition-all"
                />
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label for="proc-phone" class="block text-xs sm:text-sm font-semibold uppercase tracking-wider text-gray-700 mb-1.5">
                    Phone / WhatsApp *
                  </label>
                  <input
                    type="tel"
                    id="proc-phone"
                    name="phone"
                    required
                    placeholder="+91 70014 63876"
                    class="w-full px-4 py-3.5 rounded-xl border border-gray-300 focus:border-[#0F5A47] focus:ring-2 focus:ring-[#0F5A47]/20 outline-none text-base font-normal transition-all"
                  />
                </div>

                <div>
                  <label for="proc-email" class="block text-xs sm:text-sm font-semibold uppercase tracking-wider text-gray-700 mb-1.5">
                    Email Address *
                  </label>
                  <input
                    type="email"
                    id="proc-email"
                    name="email"
                    required
                    placeholder="hello@greviadigital.com"
                    class="w-full px-4 py-3.5 rounded-xl border border-gray-300 focus:border-[#0F5A47] focus:ring-2 focus:ring-[#0F5A47]/20 outline-none text-base font-normal transition-all"
                  />
                </div>
              </div>

              <!-- Service You Are Interested In (Multi-Select Dropdown) -->
              <div class="relative" id="proc-ms-wrapper">
                <label class="block text-xs sm:text-sm font-semibold uppercase tracking-wider text-gray-700 mb-1.5">
                  Service You Are Interested In * <span class="text-xs text-emerald-600 font-medium lowercase">(select requirements)</span>
                </label>
                <!-- Dropdown Trigger -->
                <button type="button" id="proc-ms-trigger"
                  class="w-full px-4 py-3.5 rounded-xl border border-gray-300 bg-white text-left text-sm font-medium text-gray-500 flex items-center justify-between gap-2 transition-all focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 outline-none cursor-pointer hover:border-gray-400">
                  <span id="proc-ms-display" class="truncate">Select services...</span>
                  <svg class="w-4 h-4 text-gray-400 shrink-0 transition-transform duration-200" id="proc-ms-arrow" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                  </svg>
                </button>
                <!-- Dropdown Panel -->
                <div id="proc-ms-panel" class="absolute z-50 top-full left-0 right-0 mt-1.5 bg-white border border-gray-200 rounded-xl shadow-xl p-2 space-y-1 hidden max-h-60 overflow-y-auto">
                  <label class="flex items-center gap-2.5 p-2.5 rounded-lg hover:bg-emerald-50 cursor-pointer transition-all group">
                    <input type="checkbox" name="services[]" value="Website Design" class="proc-ms-cb w-4 h-4 rounded accent-emerald-500 focus:ring-emerald-400 cursor-pointer" />
                    <span class="text-sm font-medium text-gray-700 group-hover:text-emerald-700">Website Design & Redesign</span>
                  </label>
                  <label class="flex items-center gap-2.5 p-2.5 rounded-lg hover:bg-emerald-50 cursor-pointer transition-all group">
                    <input type="checkbox" name="services[]" value="SEO Services" class="proc-ms-cb w-4 h-4 rounded accent-emerald-500 focus:ring-emerald-400 cursor-pointer" />
                    <span class="text-sm font-medium text-gray-700 group-hover:text-emerald-700">SEO & Google Search Ranking</span>
                  </label>
                  <label class="flex items-center gap-2.5 p-2.5 rounded-lg hover:bg-emerald-50 cursor-pointer transition-all group">
                    <input type="checkbox" name="services[]" value="Digital Marketing" class="proc-ms-cb w-4 h-4 rounded accent-emerald-500 focus:ring-emerald-400 cursor-pointer" />
                    <span class="text-sm font-medium text-gray-700 group-hover:text-emerald-700">Digital Marketing & Meta/Google Ads</span>
                  </label>
                  <label class="flex items-center gap-2.5 p-2.5 rounded-lg hover:bg-emerald-50 cursor-pointer transition-all group">
                    <input type="checkbox" name="services[]" value="Direct Marketing" class="proc-ms-cb w-4 h-4 rounded accent-emerald-500 focus:ring-emerald-400 cursor-pointer" />
                    <span class="text-sm font-medium text-gray-700 group-hover:text-emerald-700">WhatsApp, SMS & Email Marketing</span>
                  </label>
                  <label class="flex items-center gap-2.5 p-2.5 rounded-lg hover:bg-emerald-50 cursor-pointer transition-all group">
                    <input type="checkbox" name="services[]" value="AI Automation" class="proc-ms-cb w-4 h-4 rounded accent-emerald-500 focus:ring-emerald-400 cursor-pointer" />
                    <span class="text-sm font-medium text-gray-700 group-hover:text-emerald-700">AI Agent Setup & Automation</span>
                  </label>
                  <label class="flex items-center gap-2.5 p-2.5 rounded-lg hover:bg-emerald-50 cursor-pointer transition-all group">
                    <input type="checkbox" name="services[]" value="Support & Maintenance" class="proc-ms-cb w-4 h-4 rounded accent-emerald-500 focus:ring-emerald-400 cursor-pointer" />
                    <span class="text-sm font-medium text-gray-700 group-hover:text-emerald-700">Support, Maintenance & Renewal</span>
                  </label>
                </div>
              </div>

              <div>
                <label for="proc-message" class="block text-xs sm:text-sm font-semibold uppercase tracking-wider text-gray-700 mb-1.5">
                  Tell Us About Your Project *
                </label>
                <textarea
                  id="proc-message"
                  name="message"
                  rows="4"
                  required
                  placeholder="Briefly describe about your requirements or business goals..."
                  class="w-full px-4 py-3.5 rounded-xl border border-gray-300 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 outline-none text-base font-normal transition-all"
                ></textarea>
              </div>
            </div>

            <!-- Terms & Conditions -->
            <label class="flex items-start gap-2.5 cursor-pointer group mt-2">
              <input type="checkbox" name="terms" required class="w-4 h-4 mt-0.5 rounded accent-emerald-500 cursor-pointer" />
              <span class="text-xs sm:text-sm text-gray-600 leading-relaxed font-normal">I accept the <a href="/terms" class="text-emerald-600 font-semibold underline hover:text-emerald-800">Terms & Conditions</a> and <a href="/privacy" class="text-emerald-600 font-semibold underline hover:text-emerald-800">Privacy Policy</a> *</span>
            </label>

            <button
              type="submit"
              class="w-full py-3.5 sm:py-4 rounded-xl font-semibold text-base text-white bg-[#0F5A47] hover:bg-[#0A3E31] transition-all shadow-md hover:shadow-lg active:scale-95 text-center flex items-center justify-center gap-2 mt-4 cursor-pointer"
            >
              <span>Submit Project Enquiry</span>
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
              </svg>
            </button>

          </form>

        </div>
      </div>

    </div>

  </div>
</section>

<script>
  function initMultiSelect(prefix: string) {
    const trigger = document.getElementById(prefix + '-ms-trigger');
    const panel = document.getElementById(prefix + '-ms-panel');
    const display = document.getElementById(prefix + '-ms-display');
    const arrow = document.getElementById(prefix + '-ms-arrow') as HTMLElement | null;
    const wrapper = document.getElementById(prefix + '-ms-wrapper');
    if (!trigger || !panel || !display || !arrow || !wrapper) return;

    const checkboxes = panel.querySelectorAll<HTMLInputElement>('.' + prefix + '-ms-cb');

    trigger.addEventListener('click', () => {
      const isOpen = !panel.classList.contains('hidden');
      panel.classList.toggle('hidden');
      arrow.style.transform = isOpen ? 'rotate(0deg)' : 'rotate(180deg)';
      if (!isOpen) trigger.classList.add('border-[#0F5A47]', 'ring-2', 'ring-[#0F5A47]/20');
      else trigger.classList.remove('border-[#0F5A47]', 'ring-2', 'ring-[#0F5A47]/20');
    });

    function updateDisplay() {
      if (!display) return;
      const selected: string[] = [];
      checkboxes.forEach((cb: HTMLInputElement) => {
        if (cb.checked) {
          const label = cb.parentElement?.querySelector('span')?.textContent?.trim();
          if (label) selected.push(label);
        }
      });
      if (selected.length === 0) {
        display.textContent = 'Select services...';
        display.classList.add('text-gray-500');
        display.classList.remove('text-gray-800');
      } else {
        display.textContent = selected.join(', ');
        display.classList.remove('text-gray-500');
        display.classList.add('text-gray-800');
      }
    }

    checkboxes.forEach(cb => cb.addEventListener('change', updateDisplay));

    document.addEventListener('click', (e) => {
      if (!wrapper.contains(e.target as Node)) {
        panel.classList.add('hidden');
        arrow.style.transform = 'rotate(0deg)';
        trigger.classList.remove('border-[#0F5A47]', 'ring-2', 'ring-[#0F5A47]/20');
      }
    });
  }

  initMultiSelect('proc');
</script>
