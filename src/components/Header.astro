---
import siteConfig from '../data/site.json';

interface Props {
  activePage?: string;
}

const { activePage = 'home' } = Astro.props;

const phoneCallUrl = `tel:${siteConfig.contact.phone.replace(/[^0-9+]/g, '')}`;

const navItems = [
  { name: 'Home', href: '/', id: 'home' },
  { name: 'About', href: '/about', id: 'about' },
  { name: 'Services', href: '/services', id: 'services' },
  { name: 'Blog', href: siteConfig.blog.url, id: 'blog' },
  { name: 'Contact Us', href: '/contact', id: 'contact' },
];
---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-xl border-b border-gray-100 shadow-xs transition-all duration-300">
  <div class="container-1440">
    <div class="flex items-center justify-between h-20">
      
      <!-- Brand Logo (Matching Footer Logo Size without Tagline) -->
      <a href="/" class="flex items-center gap-3.5 group" aria-label="Grevia Digital Homepage">
        <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-[#0F5A47] to-[#0A3E31] flex items-center justify-center text-white font-bold text-2xl shadow-md shadow-[#0F5A47]/20 transition-all duration-300 group-hover:scale-105 border border-[#16A34A]/30">
          <svg class="w-6 h-6 text-[#EAB308]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
          </svg>
        </div>
        <span class="text-2xl sm:text-[26px] font-bold tracking-tight text-gray-900 group-hover:text-[#0F5A47] transition-colors">
          Grevia<span class="text-[#16A34A]">Digital</span>
        </span>
      </a>

      <!-- Desktop Navigation Links -->
      <nav class="hidden lg:flex items-center gap-7 xl:gap-8" aria-label="Main Navigation">
        {navItems.map((item) => (
          <a
            href={item.href}
            class={`relative py-1 text-[17px] xl:text-[18px] font-haffer font-medium tracking-tight transition-colors duration-200 ${
              activePage === item.id 
                ? 'text-[#0F5A47] font-semibold' 
                : 'text-gray-800 hover:text-[#0F5A47]'
            }`}
          >
            {item.name}
            {activePage === item.id && (
              <span class="absolute -bottom-1 left-0 right-0 h-0.5 bg-[#0F5A47] rounded-full"></span>
            )}
          </a>
        ))}
      </nav>

      <!-- Desktop CTA & Direct Call Buttons -->
      <div class="hidden md:flex items-center gap-3">
        <!-- Direct Phone Call Button -->
        <a
          href={phoneCallUrl}
          class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-full font-semibold text-sm text-[#0F5A47] bg-[#0F5A47]/10 hover:bg-[#0F5A47] hover:text-white transition-all duration-200 border border-[#0F5A47]/20 shadow-xs font-haffer tracking-wide"
          title="Click to Call Grevia Digital"
        >
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
          </svg>
          <span class="hidden sm:inline font-semibold font-haffer">{siteConfig.contact.phone}</span>
        </a>

        <!-- Get a Free Quote Button -->
        <a
          href="/contact"
          class="inline-flex items-center justify-center px-5 py-2.5 rounded-full font-semibold text-sm text-white bg-[#0F5A47] hover:bg-[#0A3E31] transition-all duration-200 shadow-md shadow-[#0F5A47]/20 hover:shadow-lg hover:shadow-[#0F5A47]/30 active:scale-95"
        >
          <span>Get a Free Quote</span>
          <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
          </svg>
        </a>
      </div>

      <!-- Mobile Hamburger Button with 'Menu' text -->
      <div class="flex md:hidden">
        <button
          type="button"
          id="mobile-menu-button"
          class="inline-flex items-center justify-center gap-2 px-3.5 py-2 rounded-xl text-gray-700 hover:text-[#0F5A47] hover:bg-gray-100 focus:outline-none border border-gray-200 cursor-pointer shadow-2xs transition-colors"
          aria-controls="mobile-menu"
          aria-expanded="false"
          aria-label="Toggle Navigation Menu"
        >
          <span class="text-xs sm:text-[13px] font-bold uppercase tracking-wider text-gray-700 select-none flex items-center leading-none">Menu</span>
          <svg id="menu-open-icon" class="w-7 h-7 block shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
          <svg id="menu-close-icon" class="w-7 h-7 hidden shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Dropdown Navigation Menu -->
  <div id="mobile-menu" class="hidden md:hidden border-b border-gray-200 bg-white/95 backdrop-blur-xl px-4 pt-3 pb-6 space-y-3 shadow-xl">
    <nav class="flex flex-col space-y-1.5" aria-label="Mobile Navigation">
      {navItems.map((item) => (
        <a
          href={item.href}
          class={`px-4 py-3 rounded-xl text-base font-medium transition-all ${
            activePage === item.id
              ? 'bg-[#0F5A47]/10 text-[#0F5A47] font-semibold'
              : 'text-gray-700 hover:bg-gray-50 hover:text-[#0F5A47]'
          }`}
        >
          {item.name}
        </a>
      ))}
    </nav>
    <div class="pt-2 flex flex-col gap-2.5">
      <a
        href={phoneCallUrl}
        class="w-full flex items-center justify-center gap-2 px-5 py-3 rounded-xl font-semibold text-[#0F5A47] bg-[#0F5A47]/10 border border-[#0F5A47]/20 text-center"
      >
        <svg class="w-4 h-4 fill-none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
        </svg>
        <span>Call Now: {siteConfig.contact.phone}</span>
      </a>

      <a
        href="/contact"
        class="w-full flex items-center justify-center px-5 py-3 rounded-xl font-semibold text-white bg-[#0F5A47] hover:bg-[#0A3E31] text-center shadow-md"
      >
        <span>Get a Free Quote</span>
        <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
        </svg>
      </a>
    </div>
  </div>
</header>

<script>
  const button = document.getElementById('mobile-menu-button');
  const menu = document.getElementById('mobile-menu');
  const openIcon = document.getElementById('menu-open-icon');
  const closeIcon = document.getElementById('menu-close-icon');

  if (button && menu && openIcon && closeIcon) {
    button.addEventListener('click', () => {
      const isExpanded = button.getAttribute('aria-expanded') === 'true';
      button.setAttribute('aria-expanded', (!isExpanded).toString());
      menu.classList.toggle('hidden');
      openIcon.classList.toggle('hidden');
      openIcon.classList.toggle('block');
      closeIcon.classList.toggle('hidden');
      closeIcon.classList.toggle('block');
    });
  }
</script>
