---
import siteConfig from '../data/site.json';

const currentYear = new Date().getFullYear();
---

<footer class="relative bg-gray-950 text-gray-300 pt-20 pb-16 overflow-hidden border-t border-gray-800/80">
  <!-- Top Glowing Gold/Emerald Separator Line Effect -->
  <div class="absolute top-0 inset-x-0 h-[2px] bg-gradient-to-r from-transparent via-[#EAB308] to-transparent opacity-90"></div>
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[36rem] h-24 bg-[#0F5A47]/25 rounded-full blur-3xl pointer-events-none"></div>

  <div class="container-1440 relative z-10">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-8 lg:gap-8 xl:gap-10 pb-16 border-b border-gray-800">
      
      <!-- Brand & About Column (4 Cols) -->
      <div class="lg:col-span-4 space-y-6 lg:pr-2">
        
        <div class="space-y-3">
          <a href="/" class="flex items-center gap-3.5 group" aria-label="Grevia Digital Homepage">
            <div class="w-11 h-11 rounded-xl bg-[#0F5A47] flex items-center justify-center text-white font-bold shadow-lg border border-[#16A34A]/30">
              <svg class="w-6 h-6 text-[#EAB308]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
              </svg>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-2xl sm:text-[26px] font-bold tracking-tight text-white">
                Grevia<span class="text-[#16A34A]">Digital</span>
              </span>
              <!-- Animated Indian Flag -->
              <span class="inline-flex items-center relative group/flag shrink-0" title="Based in Siliguri, India">
                <span class="w-5 h-3.5 rounded-[2px] overflow-hidden shadow-sm border border-white/20 flex flex-col justify-between inline-block align-middle transition-transform duration-300 group-hover/flag:scale-110">
                  <span class="h-[33.33%] bg-[#FF9933] w-full block"></span>
                  <span class="h-[33.33%] bg-white w-full flex items-center justify-center relative block">
                    <span class="w-1 h-1 rounded-full border-[0.5px] border-[#000080] inline-block animate-spin [animation-duration:6s]"></span>
                  </span>
                  <span class="h-[33.33%] bg-[#138808] w-full block"></span>
                </span>
              </span>
            </div>
          </a>
        </div>

        <p class="text-sm sm:text-base text-gray-300 leading-relaxed max-w-sm font-normal">
          {siteConfig.description}
        </p>

        <div class="flex items-center gap-3 pt-1">
          <span class="inline-flex items-center px-3.5 py-1.5 rounded-full text-xs font-semibold bg-emerald-500/20 text-emerald-300 border border-emerald-500/40">
            {siteConfig.experience} Experience
          </span>
          <span class="inline-flex items-center px-3.5 py-1.5 rounded-full text-xs font-semibold bg-yellow-500/10 text-yellow-400 border border-yellow-500/30">
            {siteConfig.projectsCompleted} Completed
          </span>
        </div>

        <!-- Connect With Us (Primary Social Media Links) -->
        <div class="pt-3">
          <span class="block text-xs font-semibold text-gray-400 uppercase tracking-wider mb-3">Connect With Us</span>
          <div class="flex items-center gap-2.5">
            <!-- Facebook -->
            <a
              href={siteConfig.socialLinks.facebook}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Facebook Page"
              class="w-9 h-9 rounded-xl bg-gray-800 text-gray-300 hover:text-white hover:bg-[#1877F2] flex items-center justify-center transition-all duration-300 border border-gray-700/80 hover:border-[#1877F2] hover:scale-105 shadow-sm"
            >
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
              </svg>
            </a>

            <!-- Google Business -->
            <a
              href="https://google.com"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Google Business Profile"
              class="w-9 h-9 rounded-xl bg-gray-800 text-gray-300 hover:text-white hover:bg-[#EA4335] flex items-center justify-center transition-all duration-300 border border-gray-700/80 hover:border-[#EA4335] hover:scale-105 shadow-sm"
            >
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                <path d="M12.48 10.92v3.28h7.84c-.24 1.84-.853 3.187-1.787 4.133-1.147 1.147-2.933 2.4-6.053 2.4-4.827 0-8.6-3.893-8.6-8.72s3.773-8.72 8.6-8.72c2.6 0 4.507 1.027 5.907 2.347l2.307-2.307C18.747 1.44 15.987.04 12.48.04 5.987.04.707 5.32.707 11.827s5.28 11.787 11.773 11.787c3.507 0 6.16-1.147 8.24-3.307 2.133-2.133 2.8-5.16 2.8-7.613 0-.747-.053-1.28-.16-1.773H12.48z"/>
              </svg>
            </a>

            <!-- YouTube -->
            <a
              href={siteConfig.socialLinks.youtube}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="YouTube Channel"
              class="w-9 h-9 rounded-xl bg-gray-800 text-gray-300 hover:text-white hover:bg-[#FF0000] flex items-center justify-center transition-all duration-300 border border-gray-700/80 hover:border-[#FF0000] hover:scale-105 shadow-sm"
            >
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
              </svg>
            </a>

            <!-- LinkedIn -->
            <a
              href={siteConfig.socialLinks.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="LinkedIn Profile"
              class="w-9 h-9 rounded-xl bg-gray-800 text-gray-300 hover:text-white hover:bg-[#0A66C2] flex items-center justify-center transition-all duration-300 border border-gray-700/80 hover:border-[#0A66C2] hover:scale-105 shadow-sm"
            >
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
              </svg>
            </a>

            <!-- Instagram -->
            <a
              href={siteConfig.socialLinks.instagram}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Instagram Profile"
              class="w-9 h-9 rounded-xl bg-gray-800 text-gray-300 hover:text-white hover:bg-[#E4405F] flex items-center justify-center transition-all duration-300 border border-gray-700/80 hover:border-[#E4405F] hover:scale-105 shadow-sm"
            >
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
            </a>

            <!-- X (Twitter) -->
            <a
              href={siteConfig.socialLinks.twitter}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="X (Twitter) Profile"
              class="w-9 h-9 rounded-xl bg-gray-800 text-gray-300 hover:text-white hover:bg-black flex items-center justify-center transition-all duration-300 border border-gray-700/80 hover:border-gray-500 hover:scale-105 shadow-sm"
            >
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
              </svg>
            </a>
          </div>
        </div>

      </div>

      <!-- Quick Links (2 Cols) -->
      <div class="lg:col-span-2 space-y-4">
        <p class="text-base font-semibold text-white uppercase tracking-wider">Quick Links</p>
        <ul class="space-y-3 text-[15px] font-normal">
          <li><a href="/" class="hover:text-[#16A34A] transition-colors flex items-center gap-2 group"><span class="text-xs text-gray-500 group-hover:text-[#16A34A] transition-colors">›</span> Home</a></li>
          <li><a href="/about" class="hover:text-[#16A34A] transition-colors flex items-center gap-2 group"><span class="text-xs text-gray-500 group-hover:text-[#16A34A] transition-colors">›</span> About Us</a></li>
          <li><a href="/services" class="hover:text-[#16A34A] transition-colors flex items-center gap-2 group"><span class="text-xs text-gray-500 group-hover:text-[#16A34A] transition-colors">›</span> Services</a></li>
          <li><a href={siteConfig.blog.url} class="hover:text-[#16A34A] transition-colors flex items-center gap-2 group"><span class="text-xs text-gray-500 group-hover:text-[#16A34A] transition-colors">›</span> Blog</a></li>
          <li><a href="/contact" class="hover:text-[#16A34A] transition-colors flex items-center gap-2 group"><span class="text-xs text-gray-500 group-hover:text-[#16A34A] transition-colors">›</span> Contact Us</a></li>
        </ul>
      </div>

      <!-- Services (3 Cols) -->
      <div class="lg:col-span-3 space-y-4">
        <p class="text-base font-semibold text-white uppercase tracking-wider">Our Services</p>
        <ul class="space-y-3 text-[15px] font-normal">
          <li><a href="/services#website-design" class="hover:text-[#16A34A] transition-colors flex items-center gap-2 group"><span class="text-xs text-gray-500 group-hover:text-[#16A34A] transition-colors">›</span> Website Design</a></li>
          <li><a href="/services#seo-services" class="hover:text-[#16A34A] transition-colors flex items-center gap-2 group"><span class="text-xs text-gray-500 group-hover:text-[#16A34A] transition-colors">›</span> SEO Services</a></li>
          <li><a href="/services#digital-marketing" class="hover:text-[#16A34A] transition-colors flex items-center gap-2 group"><span class="text-xs text-gray-500 group-hover:text-[#16A34A] transition-colors">›</span> Digital Marketing</a></li>
          <li><a href="/services#graphic-designing" class="hover:text-[#16A34A] transition-colors flex items-center gap-2 group"><span class="text-xs text-gray-500 group-hover:text-[#16A34A] transition-colors">›</span> Graphic Designing</a></li>
          <li><a href="/services#local-seo" class="hover:text-[#16A34A] transition-colors flex items-center gap-2 group"><span class="text-xs text-gray-500 group-hover:text-[#16A34A] transition-colors">›</span> Local SEO Siliguri</a></li>
        </ul>
      </div>

      <!-- Contact Info (3 Cols) -->
      <div class="lg:col-span-3 space-y-4">
        <p class="text-base font-semibold text-white uppercase tracking-wider">Get In Touch</p>
        <ul class="space-y-3.5 text-[15px]">
          <!-- Location -->
          <li class="flex items-start gap-3 group">
            <div class="w-8 h-8 rounded-xl bg-emerald-500/20 text-[#16A34A] flex items-center justify-center shrink-0 border border-emerald-500/30 group-hover:bg-[#16A34A] group-hover:text-white group-hover:border-[#16A34A] group-hover:scale-110 transition-all duration-300">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
            </div>
            <span class="text-gray-300 font-normal leading-snug pt-0.5 group-hover:text-white transition-colors">{siteConfig.location}</span>
          </li>

          <!-- Phone -->
          <li class="flex items-center gap-3 group">
            <a href={`tel:${siteConfig.contact.phone.replace(/[^0-9+]/g, '')}`} class="flex items-center gap-3">
              <div class="w-8 h-8 rounded-xl bg-emerald-500/20 text-[#16A34A] flex items-center justify-center shrink-0 border border-emerald-500/30 group-hover:bg-[#16A34A] group-hover:text-white group-hover:border-[#16A34A] group-hover:scale-110 transition-all duration-300">
                <svg class="w-4 h-4 fill-none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
                </svg>
              </div>
              <span class="text-gray-300 font-normal group-hover:text-[#16A34A] transition-colors">{siteConfig.contact.phone}</span>
            </a>
          </li>

          <!-- Email -->
          <li class="flex items-center gap-3 group">
            <a href={`mailto:${siteConfig.contact.email}`} class="flex items-center gap-3">
              <div class="w-8 h-8 rounded-xl bg-emerald-500/20 text-[#16A34A] flex items-center justify-center shrink-0 border border-emerald-500/30 group-hover:bg-[#16A34A] group-hover:text-white group-hover:border-[#16A34A] group-hover:scale-110 transition-all duration-300">
                <svg class="w-4 h-4 fill-none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                </svg>
              </div>
              <span class="text-gray-300 font-normal group-hover:text-[#16A34A] transition-colors">{siteConfig.contact.email}</span>
            </a>
          </li>

          <!-- Working Hours -->
          <li class="flex items-center gap-3 group">
            <div class="w-8 h-8 rounded-xl bg-yellow-500/20 text-[#EAB308] flex items-center justify-center shrink-0 border border-yellow-500/30 group-hover:bg-[#EAB308] group-hover:text-gray-900 group-hover:scale-110 transition-all duration-300">
              <svg class="w-4 h-4 fill-none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
            </div>
            <span class="text-gray-300 font-normal leading-relaxed text-sm group-hover:text-yellow-400 transition-colors">{siteConfig.contact.workingHours}</span>
          </li>
        </ul>

        <!-- MSME & Trusted Badges Below Get In Touch (Side-by-Side on Mobile, Up-and-Down Stacked on Desktop) -->
        <div class="pt-4 border-t border-gray-800 grid grid-cols-2 lg:grid-cols-1 gap-3">
          <!-- MSME Registered -->
          <div class="flex items-center gap-3 px-3 py-2 rounded-xl bg-gray-850/90 border border-amber-500/25 shadow-xs hover:border-amber-400/50 transition-all duration-300 group min-w-0" title="MSME Registered Govt. of India">
            <div class="w-7 h-7 rounded-lg bg-amber-500/15 text-amber-400 flex items-center justify-center shrink-0 border border-amber-500/30 group-hover:scale-105 transition-transform">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
              </svg>
            </div>
            <div class="flex flex-col leading-tight min-w-0">
              <span class="text-[13px] sm:text-sm font-bold text-gray-100 tracking-wide truncate">MSME Certified</span>
              <span class="text-[10px] font-medium text-amber-300/80 tracking-wide truncate">Registered under Govt. of India</span>
            </div>
          </div>

          <!-- Trusted & Secure -->
          <div class="flex items-center gap-3 px-3 py-2 rounded-xl bg-gray-850/90 border border-emerald-500/25 shadow-xs hover:border-emerald-400/50 transition-all duration-300 group min-w-0" title="256-bit SSL Secured by Let's Encrypt">
            <div class="w-7 h-7 rounded-lg bg-emerald-500/15 text-emerald-400 flex items-center justify-center shrink-0 border border-emerald-500/30 group-hover:scale-105 transition-transform">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
              </svg>
            </div>
            <div class="flex flex-col leading-tight min-w-0">
              <span class="text-[13px] sm:text-sm font-bold text-gray-100 tracking-wide truncate">Trusted &amp; Secure</span>
              <span class="text-[10px] font-medium text-emerald-300/80 tracking-wide truncate">Protected by Let's Encrypt</span>
            </div>
          </div>
        </div>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="pt-8 flex flex-col md:flex-row items-center justify-between gap-4 text-sm text-gray-400 font-medium">
      <p>© {currentYear} {siteConfig.name}. All rights reserved.</p>
      <div class="flex items-center gap-3">
        <a href="/privacy" class="hover:text-gray-200 transition-colors">Privacy Policy</a>
        <span class="w-1 h-1 rounded-full bg-gray-500 select-none" aria-hidden="true"></span>
        <a href="/terms" class="hover:text-gray-200 transition-colors">Terms & Conditions</a>
      </div>
    </div>
  </div>
</footer>
