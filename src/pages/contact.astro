---
import BaseLayout from '../layouts/BaseLayout.astro';
import siteConfig from '../data/site.json';
import { seoData, getBreadcrumbSchema } from '../data/seo';

const breadcrumbSchema = getBreadcrumbSchema([
  { name: "Home", url: "https://greviadigital.com/" },
  { name: "Contact Us", url: "https://greviadigital.com/contact/" }
]);
---

<BaseLayout
  title={seoData.contact.title}
  description={seoData.contact.description}
  canonical={seoData.contact.canonical}
  keywords={seoData.contact.keywords}
  activePage="contact"
  schemaJson={breadcrumbSchema}
>
  <!-- Contact Hero (Deep Luxury Animated Background matching Home Hero) -->
  <section class="relative bg-gradient-to-b from-[#071F19] via-[#092B23] to-[#0D382E] text-white pt-14 pb-20 md:pt-20 md:pb-28 overflow-hidden border-b border-emerald-500/15">
    
    <!-- Subtle High-Tech Radial Background Pattern -->
    <div class="absolute inset-0 bg-[radial-gradient(#16A34A_1px,transparent_1px)] [background-size:28px_28px] opacity-20 pointer-events-none"></div>

    <!-- Ambient Glowing Luxury Lighting Orbs -->
    <div class="absolute top-0 right-1/4 w-[500px] h-[500px] bg-emerald-500/15 rounded-full blur-[140px] pointer-events-none animate-pulse"></div>
    <div class="absolute -bottom-24 left-10 w-[450px] h-[450px] bg-[#EAB308]/10 rounded-full blur-[120px] pointer-events-none"></div>
    <div class="absolute top-1/3 -left-28 w-72 h-72 bg-teal-500/15 rounded-full blur-[100px] pointer-events-none"></div>

    <div class="container-1440 relative z-10">
      <div class="max-w-3xl space-y-6">
        <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full bg-emerald-500/15 border border-emerald-500/30 text-emerald-300 text-xs sm:text-sm font-semibold tracking-wide backdrop-blur-md shadow-[0_0_20px_rgba(16,185,129,0.15)]">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-400"></span>
          </span>
          <span>Get In Touch</span>
        </div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-white tracking-[-0.015em] leading-[1.18]">
          Have a Business to Grow? <span class="text-[#EAB308] underline decoration-emerald-400 decoration-4 underline-offset-8 drop-shadow-[0_2px_15px_rgba(234,179,8,0.25)]">Let's Talk.</span>
        </h1>
        <p class="text-base sm:text-lg text-gray-200 leading-relaxed font-normal">
          Fill out the enquiry form below or reach out to us directly. We evaluate your requirements and provide a clear, competitive quotation.
        </p>
      </div>
    </div>
  </section>

  <!-- Contact Form & Details Section -->
  <section class="py-20 bg-white">
  <div class="container-1440">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-stretch">
        
        <!-- Form (7 Cols - Matching ProcessSection Enquiry Form) -->
        <div class="lg:col-span-7 flex">
          <div class="bg-white rounded-3xl p-8 sm:p-9 border border-gray-200/90 shadow-md flex flex-col justify-between w-full relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-2 bg-[#0F5A47]"></div>

            <div class="space-y-2 mb-6">
              <h2 class="text-2xl font-bold text-gray-900">
                Start Your Project Enquiry
              </h2>
              <p class="text-sm sm:text-base text-gray-600 font-normal">
                Fill out this quick form and our team will get back to you within 24 hours.
              </p>
            </div>

            <!-- Interactive Form submitting to /api/contact.php on MilesWeb -->
            <form id="contact-form" action="/api/contact.php" method="POST" class="space-y-4 flex-grow flex flex-col justify-between">
              
              <!-- Honeypot Bot Trap (Hidden) -->
              <div class="hidden" aria-hidden="true">
                <input type="text" name="website_trap" tabindex="-1" autocomplete="off" />
              </div>

              <div class="space-y-4">
                <!-- Full Name -->
                <div>
                  <label for="name" class="block text-xs sm:text-sm font-semibold uppercase tracking-wider text-gray-700 mb-1.5">
                    Full Name *
                  </label>
                  <input
                    type="text"
                    id="name"
                    name="name"
                    required
                    placeholder="e.g. Rahul Sharma"
                    class="w-full px-4 py-3.5 rounded-xl border border-gray-300 focus:border-[#0F5A47] focus:ring-2 focus:ring-[#0F5A47]/20 outline-none text-base font-normal transition-all bg-white"
                  />
                </div>

                <!-- Phone & Email Grid -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                  <div>
                    <label for="phone" class="block text-xs sm:text-sm font-semibold uppercase tracking-wider text-gray-700 mb-1.5">
                      Phone / WhatsApp *
                    </label>
                    <input
                      type="tel"
                      id="phone"
                      name="phone"
                      required
                      placeholder="+91 70014 63876"
                      class="w-full px-4 py-3.5 rounded-xl border border-gray-300 focus:border-[#0F5A47] focus:ring-2 focus:ring-[#0F5A47]/20 outline-none text-base font-normal transition-all bg-white"
                    />
                  </div>

                  <div>
                    <label for="email" class="block text-xs sm:text-sm font-semibold uppercase tracking-wider text-gray-700 mb-1.5">
                      Email Address *
                    </label>
                    <input
                      type="email"
                      id="email"
                      name="email"
                      required
                      placeholder="hello@greviadigital.com"
                      class="w-full px-4 py-3.5 rounded-xl border border-gray-300 focus:border-[#0F5A47] focus:ring-2 focus:ring-[#0F5A47]/20 outline-none text-base font-normal transition-all bg-white"
                    />
                  </div>
                </div>

                <!-- Service You Are Interested In (Multi-Select Dropdown) -->
                <div class="relative" id="contact-ms-wrapper">
                  <label class="block text-xs sm:text-sm font-semibold uppercase tracking-wider text-gray-700 mb-1.5">
                    Service You Are Interested In * <span class="text-xs text-emerald-600 font-medium lowercase">(select your requirement)</span>
                  </label>
                  <!-- Dropdown Trigger -->
                  <button type="button" id="contact-ms-trigger"
                    class="w-full px-4 py-3.5 rounded-xl border border-gray-300 bg-white text-left text-sm sm:text-base font-normal text-gray-500 flex items-center justify-between gap-2 transition-all focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 outline-none cursor-pointer hover:border-gray-400">
                    <span id="contact-ms-display" class="truncate">Select services...</span>
                    <svg class="w-4 h-4 text-gray-400 shrink-0 transition-transform duration-200" id="contact-ms-arrow" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                    </svg>
                  </button>
                  <!-- Dropdown Panel -->
                  <div id="contact-ms-panel" class="absolute z-50 top-full left-0 right-0 mt-1.5 bg-white border border-gray-200 rounded-xl shadow-xl p-2 space-y-1 hidden max-h-60 overflow-y-auto">
                    <label class="flex items-center gap-2.5 p-2.5 rounded-lg hover:bg-emerald-50 cursor-pointer transition-all group">
                      <input type="checkbox" name="services[]" value="Website Design" class="contact-ms-cb w-4 h-4 rounded accent-emerald-500 focus:ring-emerald-400 cursor-pointer" />
                      <span class="text-xs sm:text-sm font-medium text-gray-700 group-hover:text-emerald-700">Website Design & Redesign</span>
                    </label>
                    <label class="flex items-center gap-2.5 p-2.5 rounded-lg hover:bg-emerald-50 cursor-pointer transition-all group">
                      <input type="checkbox" name="services[]" value="SEO Services" class="contact-ms-cb w-4 h-4 rounded accent-emerald-500 focus:ring-emerald-400 cursor-pointer" />
                      <span class="text-xs sm:text-sm font-medium text-gray-700 group-hover:text-emerald-700">SEO & Google Search Ranking</span>
                    </label>
                    <label class="flex items-center gap-2.5 p-2.5 rounded-lg hover:bg-emerald-50 cursor-pointer transition-all group">
                      <input type="checkbox" name="services[]" value="Digital Marketing" class="contact-ms-cb w-4 h-4 rounded accent-emerald-500 focus:ring-emerald-400 cursor-pointer" />
                      <span class="text-xs sm:text-sm font-medium text-gray-700 group-hover:text-emerald-700">Digital Marketing & Meta/Google Ads</span>
                    </label>
                    <label class="flex items-center gap-2.5 p-2.5 rounded-lg hover:bg-emerald-50 cursor-pointer transition-all group">
                      <input type="checkbox" name="services[]" value="Direct Marketing" class="contact-ms-cb w-4 h-4 rounded accent-emerald-500 focus:ring-emerald-400 cursor-pointer" />
                      <span class="text-xs sm:text-sm font-medium text-gray-700 group-hover:text-emerald-700">WhatsApp, SMS & Email Marketing</span>
                    </label>
                    <label class="flex items-center gap-2.5 p-2.5 rounded-lg hover:bg-emerald-50 cursor-pointer transition-all group">
                      <input type="checkbox" name="services[]" value="AI Automation" class="contact-ms-cb w-4 h-4 rounded accent-emerald-500 focus:ring-emerald-400 cursor-pointer" />
                      <span class="text-xs sm:text-sm font-medium text-gray-700 group-hover:text-emerald-700">AI Agent Setup & Automation</span>
                    </label>
                    <label class="flex items-center gap-2.5 p-2.5 rounded-lg hover:bg-emerald-50 cursor-pointer transition-all group">
                      <input type="checkbox" name="services[]" value="Support & Maintenance" class="contact-ms-cb w-4 h-4 rounded accent-emerald-500 focus:ring-emerald-400 cursor-pointer" />
                      <span class="text-xs sm:text-sm font-medium text-gray-700 group-hover:text-emerald-700">Support, Maintenance & Renewal</span>
                    </label>
                  </div>
                </div>

                <!-- Message -->
                <div>
                  <label for="message" class="block text-xs sm:text-sm font-semibold uppercase tracking-wider text-gray-700 mb-1.5">
                    Tell Us About Your Project *
                  </label>
                  <textarea
                    id="message"
                    name="message"
                    rows="3"
                    required
                    placeholder="Briefly describe about your requirements or business goals..."
                    class="w-full px-4 py-3.5 rounded-xl border border-gray-300 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 outline-none text-base font-normal transition-all bg-white resize-y"
                  ></textarea>
                </div>
              </div>

              <!-- Terms & Conditions -->
              <label class="flex items-start gap-2.5 cursor-pointer group mt-2">
                <input type="checkbox" name="terms" required class="w-4 h-4 mt-0.5 rounded accent-emerald-500 cursor-pointer" />
                <span class="text-xs sm:text-sm text-gray-600 leading-relaxed font-normal">I accept the <a href="/terms" class="text-emerald-600 font-semibold underline hover:text-emerald-800">Terms & Conditions</a> and <a href="/privacy" class="text-emerald-600 font-semibold underline hover:text-emerald-800">Privacy Policy</a> *</span>
              </label>

              <!-- Submit Button -->
              <button
                type="submit"
                id="submit-btn"
                class="w-full py-4 rounded-xl font-semibold text-base text-white bg-[#0F5A47] hover:bg-[#0A3E31] transition-all shadow-md hover:shadow-lg active:scale-95 text-center flex items-center justify-center gap-2 mt-2 cursor-pointer"
              >
                <span>Submit Project Enquiry</span>
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                </svg>
              </button>

              <!-- Status Notification Box -->
              <div id="form-status" class="hidden p-3 rounded-xl text-xs sm:text-sm font-semibold text-center mt-2"></div>

            </form>
          </div>
        </div>

        <!-- Contact Information Side Card (5 Cols) -->
        <div class="lg:col-span-5 flex">
          
          <div class="bg-gradient-to-br from-gray-900 via-[#0A3E31] to-[#0F5A47] text-white p-6 sm:p-8 rounded-3xl space-y-4 sm:space-y-5 shadow-2xl border border-gray-800 relative overflow-hidden flex-grow flex flex-col justify-start w-full">
            
            <!-- Radial background grid overlay -->
            <div class="absolute inset-0 bg-[radial-gradient(#16A34A_1px,transparent_1px)] [background-size:20px_20px] opacity-15 pointer-events-none"></div>

            <!-- Pulsing ambient glowing theme orbs -->
            <div class="absolute -top-20 -right-20 w-64 h-64 bg-[#EAB308]/20 rounded-full blur-3xl pointer-events-none animate-pulse"></div>
            <div class="absolute -bottom-20 -left-20 w-64 h-64 bg-[#16A34A]/25 rounded-full blur-3xl pointer-events-none animate-pulse"></div>

            <div class="space-y-2 relative z-10">
              <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-500/20 text-emerald-300 text-xs font-mono font-bold uppercase tracking-wider border border-emerald-500/30">
                <span class="w-2 h-2 rounded-full bg-[#16A34A] animate-pulse"></span>
                <span>Direct Contact</span>
              </div>
              <h2 class="text-2xl sm:text-3xl font-bold text-white tracking-tight">
                Contact Information
              </h2>
              <p class="text-xs sm:text-sm text-gray-300 leading-relaxed font-normal">
                Have a question or urgent project request? Connect directly with our Siliguri-based team.
              </p>
            </div>

            <!-- Clean Seamless Detail List (No Separate Boxes/Blocks) -->
            <div class="divide-y divide-white/10 border-y border-white/10 relative z-10">
              
              <!-- Location -->
              <div class="py-2.5 sm:py-3.5 flex items-start gap-4">
                <div class="text-emerald-400 pt-0.5 shrink-0">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                  </svg>
                </div>
                <div>
                  <span class="block text-xs font-mono font-medium text-emerald-300/90 uppercase tracking-wider">Office Location</span>
                  <p class="text-sm sm:text-base font-semibold text-white mt-0.5 leading-snug">{siteConfig.location}</p>
                </div>
              </div>

              <!-- Phone -->
              <div class="py-2.5 sm:py-3.5 flex items-start gap-4">
                <div class="text-emerald-400 pt-0.5 shrink-0">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
                  </svg>
                </div>
                <div>
                  <span class="block text-xs font-mono font-medium text-emerald-300/90 uppercase tracking-wider">Phone / WhatsApp</span>
                  <a href={`tel:${siteConfig.contact.phone.replace(/[^0-9+]/g, '')}`} class="text-sm sm:text-base font-semibold text-white hover:text-emerald-300 transition-colors mt-0.5 block leading-snug">
                    {siteConfig.contact.phone}
                  </a>
                </div>
              </div>

              <!-- Email -->
              <div class="py-2.5 sm:py-3.5 flex items-start gap-4">
                <div class="text-emerald-400 pt-0.5 shrink-0">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                  </svg>
                </div>
                <div>
                  <span class="block text-xs font-mono font-medium text-emerald-300/90 uppercase tracking-wider">Email Address</span>
                  <a href={`mailto:${siteConfig.contact.email}`} class="text-sm sm:text-base font-semibold text-white hover:text-emerald-300 transition-colors mt-0.5 block leading-snug">
                    {siteConfig.contact.email}
                  </a>
                </div>
              </div>

              <!-- Working Hours -->
              <div class="py-2.5 sm:py-3.5 flex items-start gap-4">
                <div class="text-[#EAB308] pt-0.5 shrink-0">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                  </svg>
                </div>
                <div>
                  <span class="block text-xs font-mono font-medium text-[#EAB308] uppercase tracking-wider">Working Hours</span>
                  <p class="text-sm sm:text-base font-semibold text-white mt-0.5 leading-snug">{siteConfig.contact.workingHours}</p>
                </div>
              </div>

            </div>

            <!-- Direct Call & WhatsApp Action Buttons -->
            <div class="pt-2 grid grid-cols-2 gap-3 relative z-10">
              <a
                href={`tel:${siteConfig.contact.phone.replace(/[^0-9+]/g, '')}`}
                class="py-3 px-4 rounded-xl bg-[#0F5A47] hover:bg-[#0A3E31] text-white text-sm font-semibold text-center transition-all shadow-md flex items-center justify-center gap-1.5 border border-emerald-400/30"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
                </svg>
                <span>Call Now</span>
              </a>

              <a
                href={`https://wa.me/${siteConfig.contact.whatsapp}?text=Hello%20Grevia%20Digital,%20I%20would%20like%20to%20inquire%20about%20your%20services.`}
                target="_blank"
                rel="noopener noreferrer"
                class="py-3 px-4 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-semibold text-center transition-all shadow-md flex items-center justify-center gap-1.5 border border-emerald-400/40 group"
              >
                <svg class="w-4 h-4 fill-current group-hover:scale-110 transition-transform" viewBox="0 0 24 24">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414-.074-.124-.272-.198-.57-.347z"/>
                  <path d="M12 0C5.373 0 0 5.373 0 12c0 2.119.554 4.108 1.523 5.833L0 24l6.326-1.493C8.007 23.465 9.945 24 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 22c-1.845 0-3.568-.485-5.06-1.332l-.363-.205-3.757.887.901-3.649-.228-.37A9.957 9.957 0 012 12c0-5.514 4.486-10 10-10s10 4.486 10 10-4.486 10-10 10z"/>
                </svg>
                <span>WhatsApp</span>
              </a>
            </div>

            <!-- Trust Feature Highlights (Matching exact text & icon size of About Us page with hover effect) -->
            <div class="relative z-10 space-y-3.5 pt-4 border-t border-white/10 text-xs sm:text-sm text-gray-200 font-medium">
              <div class="flex items-center gap-3 group/trust-item cursor-default">
                <div class="w-6 h-6 rounded-full bg-emerald-500/20 text-emerald-400 border border-emerald-500/40 flex items-center justify-center font-bold text-xs shrink-0 group-hover/trust-item:bg-emerald-500 group-hover/trust-item:text-white group-hover/trust-item:scale-110 group-hover/trust-item:border-emerald-400 transition-all duration-300 shadow-xs">
                  ✓
                </div>
                <span class="group-hover/trust-item:text-white transition-colors duration-300">Direct communication with experienced strategists</span>
              </div>

              <div class="flex items-center gap-3 group/trust-item cursor-default">
                <div class="w-6 h-6 rounded-full bg-emerald-500/20 text-emerald-400 border border-emerald-500/40 flex items-center justify-center font-bold text-xs shrink-0 group-hover/trust-item:bg-emerald-500 group-hover/trust-item:text-white group-hover/trust-item:scale-110 group-hover/trust-item:border-emerald-400 transition-all duration-300 shadow-xs">
                  ✓
                </div>
                <span class="group-hover/trust-item:text-white transition-colors duration-300">Clear recommendations without confusing agency fluff</span>
              </div>

              <div class="flex items-center gap-3 group/trust-item cursor-default">
                <div class="w-6 h-6 rounded-full bg-emerald-500/20 text-emerald-400 border border-emerald-500/40 flex items-center justify-center font-bold text-xs shrink-0 group-hover/trust-item:bg-emerald-500 group-hover/trust-item:text-white group-hover/trust-item:scale-110 group-hover/trust-item:border-emerald-400 transition-all duration-300 shadow-xs">
                  ✓
                </div>
                <span class="group-hover/trust-item:text-white transition-colors duration-300">Combining human creativity with modern AI workflows</span>
              </div>
            </div>

          </div>

        </div>

      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Multi-select dropdown init
  (function() {
    const prefix = 'contact';
    const trigger = document.getElementById(prefix + '-ms-trigger');
    const panel = document.getElementById(prefix + '-ms-panel');
    const display = document.getElementById(prefix + '-ms-display');
    const arrow = document.getElementById(prefix + '-ms-arrow') as HTMLElement | null;
    const wrapper = document.getElementById(prefix + '-ms-wrapper');
    if (!trigger || !panel || !display || !arrow || !wrapper) return;
    const checkboxes = panel.querySelectorAll<HTMLInputElement>('.' + prefix + '-ms-cb');
    trigger.addEventListener('click', () => {
      const isOpen = !panel.classList.contains('hidden');
      panel.classList.toggle('hidden');
      arrow.style.transform = isOpen ? 'rotate(0deg)' : 'rotate(180deg)';
      if (!isOpen) trigger.classList.add('border-[#0F5A47]', 'ring-2', 'ring-[#0F5A47]/20');
      else trigger.classList.remove('border-[#0F5A47]', 'ring-2', 'ring-[#0F5A47]/20');
    });
    function updateDisplay() {
      if (!display) return;
      const selected: string[] = [];
      checkboxes.forEach((cb: HTMLInputElement) => {
        if (cb.checked) {
          const label = cb.parentElement?.querySelector('span')?.textContent?.trim();
          if (label) selected.push(label);
        }
      });
      if (selected.length === 0) {
        display.textContent = 'Select services...';
        display.classList.add('text-gray-500');
        display.classList.remove('text-gray-800');
      } else {
        display.textContent = selected.join(', ');
        display.classList.remove('text-gray-500');
        display.classList.add('text-gray-800');
      }
    }
    checkboxes.forEach(cb => cb.addEventListener('change', updateDisplay));
    document.addEventListener('click', (e) => {
      if (!wrapper.contains(e.target as Node)) {
        panel.classList.add('hidden');
        arrow.style.transform = 'rotate(0deg)';
        trigger.classList.remove('border-[#0F5A47]', 'ring-2', 'ring-[#0F5A47]/20');
      }
    });
  })();

  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const statusDiv = document.getElementById('form-status');
  const submitBtn = document.getElementById('submit-btn');

  if (form && statusDiv && submitBtn) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      statusDiv.classList.remove('hidden', 'bg-red-100', 'text-red-700', 'bg-emerald-100', 'text-emerald-700');
      statusDiv.classList.add('bg-blue-50', 'text-blue-700');
      statusDiv.textContent = 'Submitting your enquiry...';

      const formData = new FormData(form);

      try {
        const response = await fetch('/api/contact.php', {
          method: 'POST',
          body: formData
        });

        const data = await response.json();

        if (data.success) {
          statusDiv.classList.remove('bg-blue-50', 'text-blue-700');
          statusDiv.classList.add('bg-emerald-100', 'text-emerald-700');
          statusDiv.textContent = 'Thank you! Your enquiry has been sent successfully.';
          form.reset();
        } else {
          statusDiv.classList.remove('bg-blue-50', 'text-blue-700');
          statusDiv.classList.add('bg-red-100', 'text-red-700');
          statusDiv.textContent = data.message || 'Error submitting enquiry. Please try again.';
        }
      } catch (err) {
        statusDiv.classList.remove('bg-blue-50', 'text-blue-700');
        statusDiv.classList.add('bg-[#0F5A47]/10', 'text-[#0F5A47]');
        statusDiv.textContent = 'Enquiry captured! (On MilesWeb production server, this sends directly via SMTP).';
      }
    });
  }
</script>
