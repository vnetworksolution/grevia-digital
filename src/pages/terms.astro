---
import BaseLayout from '../layouts/BaseLayout.astro';
import siteConfig from '../data/site.json';
import { seoData, getBreadcrumbSchema } from '../data/seo';

const breadcrumbSchema = getBreadcrumbSchema([
  { name: "Home", url: "https://greviadigital.com/" },
  { name: "Terms and Conditions", url: "https://greviadigital.com/terms/" }
]);

const lastUpdated = "October 2026";
---

<BaseLayout
  title={seoData.terms.title}
  description={seoData.terms.description}
  canonical={seoData.terms.canonical}
  keywords={seoData.terms.keywords}
  activePage="terms"
  schemaJson={breadcrumbSchema}
>
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-b from-[#071F19] via-[#092B23] to-[#0D382E] text-white pt-14 pb-16 md:pt-20 md:pb-24 overflow-hidden border-b border-emerald-500/15">
    <div class="absolute inset-0 bg-[radial-gradient(#16A34A_1px,transparent_1px)] [background-size:28px_28px] opacity-20 pointer-events-none"></div>
    <div class="absolute top-0 right-1/4 w-[450px] h-[450px] bg-emerald-500/15 rounded-full blur-[140px] pointer-events-none animate-pulse"></div>
    <div class="absolute -bottom-24 left-10 w-[400px] h-[400px] bg-[#EAB308]/10 rounded-full blur-[120px] pointer-events-none"></div>

    <div class="container-1440 relative z-10">
      <div class="max-w-3xl space-y-4">
        <!-- Badge -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-emerald-500/15 border border-emerald-500/30 text-emerald-300 text-xs sm:text-sm font-semibold tracking-wide backdrop-blur-md">
          <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
          </svg>
          <span>Agreements & Terms of Service</span>
        </div>

        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white tracking-[-0.015em] leading-[1.2]">
          Terms & Conditions
        </h1>
        <p class="text-base sm:text-lg text-gray-200 leading-relaxed font-normal">
          Clear, honest, and straightforward terms covering our website, project engagements, and digital marketing services.
        </p>

        <div class="pt-3 flex items-center gap-2.5 text-xs sm:text-sm text-[#EAB308] font-mono font-medium">
          <span class="relative flex h-2.5 w-2.5">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#EAB308] opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-[#EAB308]"></span>
          </span>
          <span>Last Updated: {lastUpdated}</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Content Section -->
  <section class="py-20 md:py-28 bg-white">
    <div class="container-1440">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 xl:gap-16 items-start">
        
        <!-- Sidebar Navigation / Highlights - INSIDE A BLOCK CARD -->
        <div class="lg:col-span-4 lg:sticky lg:top-28">
          <div class="bg-gray-50/80 rounded-3xl p-6 sm:p-7 border border-gray-200/90 shadow-sm space-y-5">
            <div class="border-b border-gray-200 pb-3">
              <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 tracking-tight">
                Key Principles
              </h2>
            </div>

            <ul class="space-y-4 text-[15px] sm:text-base text-gray-700 leading-relaxed font-normal">
              <li class="flex items-start gap-3">
                <span class="text-[#0F5A47] font-extrabold shrink-0 mt-0.5 text-lg">✓</span>
                <span>Transparent scopes of work with zero hidden surprises.</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="text-[#0F5A47] font-extrabold shrink-0 mt-0.5 text-lg">✓</span>
                <span>You retain full ownership of your domain, website code, and creative assets upon full payment.</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="text-[#0F5A47] font-extrabold shrink-0 mt-0.5 text-lg">✓</span>
                <span>White-hat, compliant SEO and digital marketing practices aligned with Google and Meta guidelines.</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="text-[#0F5A47] font-extrabold shrink-0 mt-0.5 text-lg">✓</span>
                <span>Milestone-based billing and clear sign-off stages.</span>
              </li>
            </ul>

            <div class="pt-5 border-t border-gray-200 space-y-2">
              <p class="text-xs font-mono font-bold uppercase tracking-wider text-gray-500">Need Clarification?</p>
              <p class="text-[15px] text-gray-600">For any questions regarding these Agreement, Write to our team directly:</p>
              <a href={`mailto:${siteConfig.contact.email}`} class="inline-flex items-center gap-2 text-base font-semibold text-[#0F5A47] hover:text-[#16A34A] transition-colors break-all">
                <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                </svg>
                {siteConfig.contact.email}
              </a>
            </div>
          </div>
        </div>

        <!-- Main Legal Body - NO BLOCK (Clean open text) -->
        <div class="lg:col-span-8 space-y-12 text-gray-700 leading-relaxed text-base sm:text-[17px]">
          
          <!-- Introduction -->
          <div class="space-y-4">
            <h2 class="text-xl sm:text-2xl font-bold text-gray-900 tracking-tight">1. Agreement to Terms</h2>
            <p>
              These Terms and Conditions constitute a legally binding agreement between you (whether personally or on behalf of an entity) and <strong>{siteConfig.name}</strong> ("{siteConfig.legalName}", "we," "us," or "our"), concerning your access to and use of our website (<strong>greviadigital.com</strong>) and any digital marketing, website design, and SEO services we provide.
            </p>
            <p>
              By browsing our website, requesting a quote, or engaging our services, you confirm that you have read, understood, and agreed to be bound by these terms.
            </p>
          </div>

          <!-- Services We Provide -->
          <div class="space-y-3">
            <h2 class="text-xl sm:text-2xl font-bold text-gray-900 tracking-tight">2. Our Services & Scope of Work</h2>
            <p>
              Grevia Digital specializes in three core digital disciplines:
            </p>
            <ul class="list-disc pl-5 space-y-1.5 text-gray-600">
              <li><strong>Website Design & Development:</strong> High-performance business websites, WordPress development, landing pages, and web optimization.</li>
              <li><strong>Search Engine Optimization (SEO):</strong> On-page SEO, technical SEO audits, Google Business Profile optimization, local SEO, content strategy, and search visibility growth.</li>
              <li><strong>Digital Marketing & Paid Ads:</strong> Meta (Facebook & Instagram) ads, Google Ads campaign management, lead generation, and analytics setup.</li>
            </ul>
            <p>
              For every client project, specific deliverables, timelines, milestones, and costs are agreed upon through a formal quotation, proposal, or statement of work (SOW) prior to project kickoff.
            </p>
          </div>

          <!-- Client Responsibilities -->
          <div class="space-y-3">
            <h2 class="text-xl sm:text-2xl font-bold text-gray-900 tracking-tight">3. Client Cooperation & Responsibilities</h2>
            <p>
              To ensure projects are completed on schedule and achieve the best results, you agree to:
            </p>
            <ul class="list-disc pl-5 space-y-2 text-gray-600">
              <li><strong>Provide Content & Assets:</strong> Supply accurate text, images, brand logos, product details, and other necessary assets in a timely manner.</li>
              <li><strong>Timely Feedback:</strong> Review design mockups, wireframes, or strategy drafts and share feedback or approvals within agreed review windows.</li>
              <li><strong>Account Access:</strong> When required for service delivery (e.g., SEO or Google Ads), provide necessary administrative or editor access to your hosting, Google Search Console, Google Analytics, or Ads accounts.</li>
              <li><strong>Legal Ownership:</strong> Ensure that all materials, images, and text supplied to us do not violate any copyright, trademark, or intellectual property rights.</li>
            </ul>
          </div>

          <!-- Quotations, Payments & Billing -->
          <div class="space-y-3">
            <h2 class="text-xl sm:text-2xl font-bold text-gray-900 tracking-tight">4. Quotations, Pricing & Payments</h2>
            <p>
              Our pricing is clear and agreed upon in advance:
            </p>
            <ul class="list-disc pl-5 space-y-2 text-gray-600">
              <li><strong>Project Advance:</strong> Fixed-scope website design and development projects generally require an initial advance deposit before work begins, with remaining balances tied to milestone reviews and final launch approval.</li>
              <li><strong>Monthly Retainers:</strong> Ongoing SEO and digital marketing management services are billed on a monthly retainer basis at the start of each service billing cycle.</li>
              <li><strong>Ad Spend Budget:</strong> Advertising spend paid directly to platforms (Google Ads, Meta Ads) is paid directly by the client or funded in advance into your advertising accounts. Our management fee covers campaign strategy, design, and optimization only.</li>
              <li><strong>Invoices & Payment Methods:</strong> We accept payments via UPI, NEFT/IMPS bank transfer, and major credit/debit cards. All invoices must be settled according to the payment terms stated on the invoice.</li>
            </ul>
          </div>

          <!-- Intellectual Property & Ownership -->
          <div class="space-y-3">
            <h2 class="text-xl sm:text-2xl font-bold text-gray-900 tracking-tight">5. Intellectual Property & Ownership</h2>
            <p>
              We believe in client ownership and transparency:
            </p>
            <ul class="list-disc pl-5 space-y-2 text-gray-600">
              <li><strong>Your Ownership:</strong> Once the final payment for a custom website design or creative project is completed in full, all custom design files, code, and graphical assets created specifically for your project become your property.</li>
              <li><strong>Pre-existing Code & Frameworks:</strong> Open-source CMS platforms (such as WordPress or Astro), third-party plugins, stock photos, and general frameworks remain subject to their respective open-source or commercial licenses.</li>
              <li><strong>Portfolio Rights:</strong> Unless explicitly agreed otherwise under a non-disclosure agreement (NDA), Grevia Digital reserves the right to display completed projects, screenshots, and achieved growth metrics as case studies in our portfolio and marketing materials.</li>
            </ul>
          </div>

          <!-- SEO & Marketing Realistic Guarantees -->
          <div class="space-y-3">
            <h2 class="text-xl sm:text-2xl font-bold text-gray-900 tracking-tight">6. Search Rankings & Performance Expectations</h2>
            <p>
              We pride ourselves on using white-hat, industry-standard SEO techniques that align with Google Search Essentials and quality guidelines. However, in the spirit of honest communication:
            </p>
            <p class="p-4 rounded-xl bg-amber-50/80 border border-amber-200/80 text-amber-900 text-sm">
              <strong>Honest SEO Guarantee:</strong> No ethical agency can guarantee an absolute #1 ranking on Google, because search engines frequently update their algorithms and search results are influenced by many external factors including competitor activities and search intent. We guarantee rigorous, proven optimization, continuous data-driven improvements, and full transparency in all monthly reporting.
            </p>
          </div>

          <!-- Revisions & Scope Changes -->
          <div class="space-y-3">
            <h2 class="text-xl sm:text-2xl font-bold text-gray-900 tracking-tight">7. Revisions & Scope Changes</h2>
            <p>
              Every website design project includes designated revision rounds at the wireframe and design draft stages to ensure you are 100% satisfied. Requests for completely new features, additional pages, or architectural changes outside the original signed scope will be quoted separately as an add-on.
            </p>
          </div>

          <!-- Cancellation & Termination -->
          <div class="space-y-3">
            <h2 class="text-xl sm:text-2xl font-bold text-gray-900 tracking-tight">8. Project Cancellation & Retainers</h2>
            <p>
              Either party may pause or terminate a monthly marketing retainer with written notice (email is sufficient) prior to the next billing cycle. For fixed-cost website development projects cancelled midway by the client, payments made cover work completed up to the cancellation date and are non-refundable.
            </p>
          </div>

          <!-- Limitation of Liability -->
          <div class="space-y-3">
            <h2 class="text-xl sm:text-2xl font-bold text-gray-900 tracking-tight">9. Limitation of Liability</h2>
            <p>
              To the maximum extent permitted by applicable law, Grevia Digital will not be liable for any indirect, incidental, or consequential losses, including lost revenue, lost profits, or business interruptions arising from website downtime caused by your third-party web host, platform algorithm updates (e.g. Google or Facebook), or cyber attacks outside our control.
            </p>
          </div>

          <!-- Governing Law -->
          <div class="space-y-3">
            <h2 class="text-xl sm:text-2xl font-bold text-gray-900 tracking-tight">10. Governing Law & Dispute Resolution</h2>
            <p>
              These Terms and Conditions and any separate agreements shall be governed by and construed in accordance with the laws of India. Any disputes arising out of or related to our services shall be subject to the exclusive jurisdiction of the competent courts in Siliguri, West Bengal, India.
            </p>
          </div>

        </div>

      </div>
    </div>
  </section>
</BaseLayout>
