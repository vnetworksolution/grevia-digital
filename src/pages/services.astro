---
import BaseLayout from '../layouts/BaseLayout.astro';
import { servicesData } from '../data/services';
import { seoData, getBreadcrumbSchema } from '../data/seo';
import ApproachSection from '../components/home/ApproachSection.astro';
import QuoteCtaSection from '../components/home/QuoteCtaSection.astro';

const breadcrumbSchema = getBreadcrumbSchema([
  { name: "Home", url: "https://greviadigital.com/" },
  { name: "Services", url: "https://greviadigital.com/services/" }
]);

const aiBadgeTitles: Record<string, string> = {
  "website-design": "AI-POWERED WEB APPLICATION DESIGN",
  "seo-services": "AI-POWERED SEARCH ENGINE VISIBILITY",
  "digital-marketing": "AI-POWERED LEAD GENERATION",
  "graphic-designing": "AI-POWERED BRAND IDENTITY & DESIGN"
};

const iconPaths: Record<string, string> = {
  "layout": `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z" />`,
  "zap": `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />`,
  "target": `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 2a10 10 0 100 20 10 10 0 000-20zm0 6a4 4 0 100 8 4 4 0 000-8zm0 2a2 2 0 110 4 2 2 0 010-4z" />`,
  "smartphone": `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" />`,
  "search": `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />`,
  "shield-check": `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />`,
  "refresh-cw": `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />`,
  "server": `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01" />`,
  "file-text": `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />`,
  "code": `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />`,
  "share-2": `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />`,
  "image": `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />`,
  "map-pin": `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />`,
  "google-profile": `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />`,
  "store": `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />`,
  "cpu": `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v2m6-2v2M9 19v2m6-2v2M3 9h2m-2 6h2m14-6h2m-2 6h2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z" />`,
  "share": `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />`,
  "thumbs-up": `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 10h4.764a2 2 0 011.789 2.894l-3.5 7A2 2 0 0115.263 21h-4.017c-.163 0-.326-.02-.485-.06L7 20m7-10V5a2 2 0 00-2-2h-.095c-.5 0-.905.405-.905.905 0 .714-.211 1.412-.608 2.006L7 11v9m7-10h-2M7 20H5a2 2 0 01-2-2v-6a2 2 0 012-2h2" />`,
  "video": `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />`,
  "user-plus": `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z" />`,
  "message-circle": `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8h2a2 2 0 012 2v6a2 2 0 01-2 2h-2v4l-4-4H9a1.994 1.994 0 01-1.414-.586m0 0L11 14h4a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2v4l.586-.586z" />`,
  "mail": `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />`,
  "megaphone": `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z" />`,
  "pen-tool": `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />`,
  "layers": `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />`,
  "layout-grid": `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />`,
  "credit-card": `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />`
};
---

<BaseLayout
  title={seoData.services.title}
  description={seoData.services.description}
  canonical={seoData.services.canonical}
  keywords={seoData.services.keywords}
  activePage="services"
  schemaJson={breadcrumbSchema}
>
  <!-- Hero (Deep Luxury Animated Background matching Home Hero) -->
  <section class="relative bg-gradient-to-b from-[#071F19] via-[#092B23] to-[#0D382E] text-white pt-14 pb-20 md:pt-20 md:pb-28 overflow-hidden border-b border-emerald-500/15">
    
    <!-- Subtle High-Tech Radial Background Pattern -->
    <div class="absolute inset-0 bg-[radial-gradient(#16A34A_1px,transparent_1px)] [background-size:28px_28px] opacity-20 pointer-events-none"></div>

    <!-- Ambient Glowing Luxury Lighting Orbs -->
    <div class="absolute top-0 right-1/4 w-[500px] h-[500px] bg-emerald-500/15 rounded-full blur-[140px] pointer-events-none animate-pulse"></div>
    <div class="absolute -bottom-24 left-10 w-[450px] h-[450px] bg-[#EAB308]/10 rounded-full blur-[120px] pointer-events-none"></div>
    <div class="absolute top-1/3 -left-28 w-72 h-72 bg-teal-500/15 rounded-full blur-[100px] pointer-events-none"></div>

    <div class="container-1440 relative z-10">
      <div class="max-w-3xl space-y-6">
        <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full bg-emerald-500/15 border border-emerald-500/30 text-emerald-300 text-xs sm:text-sm font-semibold tracking-wide backdrop-blur-md shadow-[0_0_20px_rgba(16,185,129,0.15)]">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-400"></span>
          </span>
          <span>Our Complete Offerings</span>
        </div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-white tracking-[-0.015em] leading-[1.18]">
          Complete Web, SEO & <span class="text-[#EAB308] underline decoration-emerald-400 decoration-4 underline-offset-8 drop-shadow-[0_2px_15px_rgba(234,179,8,0.25)]">Digital Marketing Solutions</span>
        </h1>
        <p class="text-base sm:text-lg text-gray-200 leading-relaxed font-normal">
          Comprehensive, high-performance digital services tailored specifically for business growth, search engine authority, customer lead generation, and brand identity.
        </p>
      </div>
    </div>
  </section>

  <!-- The Grevia Difference Section -->
  <ApproachSection />

  <!-- Deep Dive Category Focus Service Section -->
  <section class="pt-6 sm:pt-8 pb-16 sm:pb-20 bg-white">
    <div class="container-1440 space-y-12">
      
      <!-- Interactive Tabbed Service Switcher (With Top Gap & Matching Background Design Color) -->
      <div id="service-category-menu" class="sticky top-24 z-30 bg-[#F9FAF6]/95 backdrop-blur-md py-3.5 border border-gray-200/90 shadow-md rounded-2xl px-4 sm:px-6 mb-6">
        <div class="flex flex-wrap items-center justify-between gap-4">
          <div class="text-xs sm:text-sm font-semibold text-gray-500 uppercase tracking-wider flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-[#EAB308]"></span>
            <span>Select Category:</span>
          </div>

          <!-- Tab Buttons -->
          <div class="flex flex-wrap items-center gap-2" id="service-tabs">
            <button
              data-tab="all"
              class="tab-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold transition-all duration-200 bg-[#0F5A47] text-white shadow-md border border-[#0F5A47]"
            >
              All Categories
            </button>
            
            {servicesData.map((cat) => (
              <button
                data-tab={cat.id}
                class="tab-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold transition-all duration-200 bg-white text-gray-800 hover:bg-[#0F5A47] hover:text-white border border-gray-200/90 shadow-xs"
              >
                {cat.title}
              </button>
            ))}
          </div>
        </div>
      </div>

      <!-- Categories Container -->
      <div class="space-y-24">
        {servicesData.map((category) => (
          <div id={category.id} class="service-category-block scroll-mt-48 sm:scroll-mt-52 space-y-12 transition-all duration-300">
            
            <!-- Dark Glassmorphic Theme Category Focus Header (Matching Our Core AI-Powered Pillars Homepage Section) -->
            <div class="relative bg-gradient-to-br from-gray-900 via-[#0A3E31] to-[#0F5A47] text-white rounded-3xl p-8 sm:p-10 border border-white/15 shadow-2xl overflow-hidden group/header">
              
              <!-- Subtle Emerald Grid Overlay -->
              <div class="absolute inset-0 bg-[radial-gradient(#16A34A_1px,transparent_1px)] [background-size:24px_24px] opacity-10 pointer-events-none"></div>

              <!-- Ambient Animated Glowing Orbs (Pulse Animation Matching Homepage) -->
              <div class="absolute -top-16 -right-16 w-64 h-64 bg-[#16A34A]/25 rounded-full blur-[80px] pointer-events-none animate-pulse"></div>
              <div class="absolute -bottom-16 -left-16 w-64 h-64 bg-[#EAB308]/15 rounded-full blur-[80px] pointer-events-none animate-pulse"></div>

              <!-- Subtle Corner Hover Accent Glow -->
              <div class="absolute -top-12 -right-12 w-32 h-32 bg-gradient-to-br from-[#16A34A]/30 to-[#EAB308]/20 rounded-full blur-2xl group-hover/header:scale-150 transition-transform duration-700 pointer-events-none"></div>

              <div class="flex flex-col md:flex-row items-start md:items-end justify-between gap-6 relative z-10">
                <div class="space-y-4 max-w-3xl">
                  
                  <!-- AI Badge (Clean, No Icon Before Content, No AI 2.0) -->
                  <div class="inline-flex items-center gap-2 px-3.5 py-1.5 bg-emerald-950/80 border border-emerald-500/40 text-emerald-300 text-xs font-mono font-bold uppercase rounded-full shadow-sm tracking-wider">
                    <span class="relative flex h-2 w-2">
                      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                      <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-400"></span>
                    </span>
                    <span>{aiBadgeTitles[category.id] || "AI-POWERED DIGITAL SOLUTIONS"}</span>
                  </div>

                  <!-- Category Title -->
                  <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white tracking-tight">
                    {category.title}
                  </h2>

                  <!-- Tagline with Lightning Shock Icon (Static, Non-Animated) -->
                  <p class="text-base sm:text-lg font-semibold text-emerald-300 flex items-center gap-2">
                    <svg class="w-4 h-4 text-[#EAB308] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                    </svg>
                    <span>{category.tagline}</span>
                  </p>

                  <!-- Overview -->
                  <p class="text-gray-200 text-sm sm:text-base leading-relaxed font-normal pt-1">
                    {category.overview}
                  </p>
                </div>

                <!-- Category Main CTA Button -->
                <div class="shrink-0 relative z-10">
                  <a
                    href="/contact"
                    class="inline-flex items-center justify-center px-6 py-3.5 rounded-xl font-semibold text-sm sm:text-base text-gray-900 bg-[#EAB308] hover:bg-yellow-400 transition-all shadow-lg hover:shadow-yellow-500/20 text-center group/btn"
                  >
                    <span>Get {category.title} Proposal</span>
                    <svg class="w-4 h-4 ml-2 group-hover/btn:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                    </svg>
                  </a>
                </div>
              </div>
            </div>

            <!-- Open 2-Column Feature Matrix (Non-block open design with unique vector icons) -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-x-12 gap-y-10">
              {category.services.map((item) => (
                <div class="pt-6 border-t border-gray-200 space-y-4 group">
                  
                  <!-- Unique Vector Icon + Title Header -->
                  <div class="flex items-start gap-4">
                    <div class="w-10 h-10 rounded-2xl bg-[#0F5A47]/10 text-[#0F5A47] border border-[#0F5A47]/20 flex items-center justify-center shrink-0 group-hover:bg-[#0F5A47] group-hover:text-white transition-all shadow-sm">
                      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" set:html={iconPaths[item.iconName] || iconPaths["zap"]}>
                      </svg>
                    </div>

                    <div class="space-y-1">
                      <h3 class="text-xl font-bold text-gray-900 group-hover:text-[#0F5A47] transition-colors leading-snug">
                        {item.title}
                      </h3>
                      <p class="text-sm sm:text-[15px] text-gray-600 leading-relaxed font-normal">
                        {item.shortDescription}
                      </p>
                    </div>
                  </div>

                  <!-- Open Inline Feature Tags List -->
                  <div class="pl-14 flex flex-wrap gap-2">
                    {item.features.map((feat) => (
                      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#0F5A47]/8 text-[#0F5A47] text-xs font-medium border border-[#0F5A47]/15">
                        <span class="text-[#16A34A] font-bold text-xs">✓</span>
                        <span>{feat}</span>
                      </span>
                    ))}
                  </div>

                </div>
              ))}
            </div>

            <!-- Section Separator Banner -->
            <div class="pt-6 border-b border-gray-200"></div>

          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- Client-side Interactive Tab Switcher Script -->
  <script>
    function initTabs() {
      const tabBtns = document.querySelectorAll('.tab-btn');
      const categoryBlocks = document.querySelectorAll('.service-category-block');

      if (!tabBtns.length) return;

      function scrollToCategory(targetId: string, smooth = true) {
        // Highlight active tab button
        tabBtns.forEach((b) => {
          const btnTab = b.getAttribute('data-tab');
          if (btnTab === targetId) {
            b.classList.remove('bg-white', 'text-gray-800', 'border-gray-200/90', 'shadow-xs');
            b.classList.add('bg-[#0F5A47]', 'text-white', 'border-[#0F5A47]', 'shadow-md');
          } else {
            b.classList.remove('bg-[#0F5A47]', 'text-white', 'border-[#0F5A47]', 'shadow-md');
            b.classList.add('bg-white', 'text-gray-800', 'border-gray-200/90', 'shadow-xs');
          }
        });

        // Ensure all categories are visible
        categoryBlocks.forEach((block) => {
          (block as HTMLElement).style.display = 'block';
        });

        const stickyMenu = document.getElementById('service-category-menu') as HTMLElement;
        const header = document.querySelector('header') as HTMLElement;
        const headerH = header ? header.offsetHeight : 80;
        const menuH = stickyMenu ? stickyMenu.offsetHeight : 70;
        // Consistent fixed gap: 32px on mobile (<640px), 40px on desktop
        const gap = window.innerWidth < 640 ? 32 : 40;
        const totalOffset = headerH + menuH + gap;

        const targetElement = targetId === 'all' 
          ? (categoryBlocks[0] as HTMLElement)
          : (document.getElementById(targetId) || document.getElementById('website-design'));

        if (targetElement) {
          const targetPosition = targetElement.getBoundingClientRect().top + window.pageYOffset - totalOffset;
          window.scrollTo({
            top: Math.max(0, targetPosition),
            behavior: smooth ? 'smooth' : 'auto'
          });
        }
      }

      tabBtns.forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          const targetId = btn.getAttribute('data-tab');
          if (targetId) {
            scrollToCategory(targetId, true);
            // Optionally update URL hash without jump
            if (targetId !== 'all') {
              history.replaceState(null, '', `#${targetId}`);
            } else {
              history.replaceState(null, '', window.location.pathname);
            }
          }
        });
      });

      // Handle footer and in-page anchor links to services
      const serviceLinks = document.querySelectorAll('a[href*="/services#"], a[href^="#"]');
      serviceLinks.forEach((link) => {
        link.addEventListener('click', (e) => {
          const href = link.getAttribute('href') || '';
          const hashIndex = href.indexOf('#');
          if (hashIndex !== -1) {
            const hash = href.slice(hashIndex + 1);
            const targetEl = document.getElementById(hash);
            if (targetEl) {
              e.preventDefault();
              scrollToCategory(hash, true);
              history.replaceState(null, '', `#${hash}`);
            }
          }
        });
      });

      // Handle direct page load with hash (e.g. from footer click on another page)
      if (window.location.hash) {
        const initialHash = window.location.hash.replace('#', '');
        setTimeout(() => {
          scrollToCategory(initialHash, false);
        }, 100);
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initTabs);
    } else {
      initTabs();
    }
    document.addEventListener('astro:page-load', initTabs);
  </script>

  <!-- CTA -->
  <QuoteCtaSection />
</BaseLayout>
