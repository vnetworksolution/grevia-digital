---
import BaseLayout from '../layouts/BaseLayout.astro';
import siteConfig from '../data/site.json';
import { seoData, getBreadcrumbSchema } from '../data/seo';

const breadcrumbSchema = getBreadcrumbSchema([
  { name: "Home", url: "https://greviadigital.com/" },
  { name: "Privacy Policy", url: "https://greviadigital.com/privacy/" }
]);

const lastUpdated = "October 2026";
---

<BaseLayout
  title={seoData.privacy.title}
  description={seoData.privacy.description}
  canonical={seoData.privacy.canonical}
  keywords={seoData.privacy.keywords}
  activePage="privacy"
  schemaJson={breadcrumbSchema}
>
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-b from-[#071F19] via-[#092B23] to-[#0D382E] text-white pt-14 pb-16 md:pt-20 md:pb-24 overflow-hidden border-b border-emerald-500/15">
    <div class="absolute inset-0 bg-[radial-gradient(#16A34A_1px,transparent_1px)] [background-size:28px_28px] opacity-20 pointer-events-none"></div>
    <div class="absolute top-0 right-1/4 w-[450px] h-[450px] bg-emerald-500/15 rounded-full blur-[140px] pointer-events-none animate-pulse"></div>
    <div class="absolute -bottom-24 left-10 w-[400px] h-[400px] bg-[#EAB308]/10 rounded-full blur-[120px] pointer-events-none"></div>

    <div class="container-1440 relative z-10">
      <div class="max-w-3xl space-y-4">
        <!-- Badge -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-emerald-500/15 border border-emerald-500/30 text-emerald-300 text-xs sm:text-sm font-semibold tracking-wide backdrop-blur-md">
          <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
          </svg>
          <span>Legal & Transparency</span>
        </div>

        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white tracking-[-0.015em] leading-[1.2]">
          Privacy Policy
        </h1>
        <p class="text-base sm:text-lg text-gray-200 leading-relaxed font-normal">
          We respect your privacy and believe in being completely clear about how we collect, use, and protect your information.
        </p>

        <div class="pt-3 flex items-center gap-2.5 text-xs sm:text-sm text-[#EAB308] font-mono font-medium">
          <span class="relative flex h-2.5 w-2.5">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#EAB308] opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-[#EAB308]"></span>
          </span>
          <span>Last Updated: {lastUpdated}</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Content Section -->
  <section class="py-20 md:py-28 bg-white">
    <div class="container-1440">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 xl:gap-16 items-start">
        
        <!-- Sidebar Navigation / Highlights - INSIDE A BLOCK CARD -->
        <div class="lg:col-span-4 lg:sticky lg:top-28">
          <div class="bg-gray-50/80 rounded-3xl p-6 sm:p-7 border border-gray-200/90 shadow-sm space-y-5">
            <div class="border-b border-gray-200 pb-3">
              <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 tracking-tight">
                Quick Summary
              </h2>
            </div>

            <ul class="space-y-4 text-[15px] sm:text-base text-gray-700 leading-relaxed font-normal">
              <li class="flex items-start gap-3">
                <span class="text-[#0F5A47] font-extrabold shrink-0 mt-0.5 text-lg">✓</span>
                <span>We only collect data required to serve you or respond to your enquiries.</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="text-[#0F5A47] font-extrabold shrink-0 mt-0.5 text-lg">✓</span>
                <span>We never sell or rent your personal information to third parties.</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="text-[#0F5A47] font-extrabold shrink-0 mt-0.5 text-lg">✓</span>
                <span>You can request deletion or correction of your data at any time.</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="text-[#0F5A47] font-extrabold shrink-0 mt-0.5 text-lg">✓</span>
                <span>All communication is handled securely.</span>
              </li>
            </ul>

            <div class="pt-5 border-t border-gray-200 space-y-2">
              <p class="text-xs font-mono font-bold uppercase tracking-wider text-gray-500">Have Questions?</p>
              <p class="text-[15px] text-gray-600">For any questions regarding these Privacy Policy, Write to our team directly:</p>
              <a href={`mailto:${siteConfig.contact.email}`} class="inline-flex items-center gap-2 text-base font-semibold text-[#0F5A47] hover:text-[#16A34A] transition-colors break-all">
                <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                </svg>
                {siteConfig.contact.email}
              </a>
            </div>
          </div>
        </div>

        <!-- Main Legal Body - NO BLOCK (Clean open text) -->
        <div class="lg:col-span-8 space-y-12 text-gray-700 leading-relaxed text-base sm:text-[17px]">
          
          <!-- Introduction -->
          <div class="space-y-4">
            <h2 class="text-xl sm:text-2xl font-bold text-gray-900 tracking-tight">1. Who We Are</h2>
            <p>
              Welcome to <strong>{siteConfig.name}</strong> ("we," "our," or "us"). We are a digital marketing, website design, and search engine optimization (SEO) agency based in {siteConfig.location}.
            </p>
            <p>
              This Privacy Policy explains in simple terms how we handle your personal information when you visit our website (<strong>greviadigital.com</strong>), submit contact or project enquiry forms, or partner with us for marketing and web development services.
            </p>
          </div>

          <!-- Information We Collect -->
          <div class="space-y-4">
            <h2 class="text-xl sm:text-2xl font-bold text-gray-900 tracking-tight">2. Information We Collect</h2>
            <p>We only collect information that is genuinely necessary to deliver our services and communicate effectively with you:</p>
            
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
              <div class="p-4 rounded-xl bg-gray-50 border border-gray-100 space-y-1.5">
                <h3 class="text-sm font-bold text-gray-900">Information You Give Us Directly</h3>
                <p class="text-xs sm:text-sm text-gray-600 leading-normal">
                  When you submit an enquiry, project request, or contact form, you may provide your name, email address, phone/WhatsApp number, company name, website URL, and details about your project requirements.
                </p>
              </div>

              <div class="p-4 rounded-xl bg-gray-50 border border-gray-100 space-y-1.5">
                <h3 class="text-sm font-bold text-gray-900">Technical & Browsing Data</h3>
                <p class="text-xs sm:text-sm text-gray-600 leading-normal">
                  When you browse our website, our analytics tools may automatically record standard browser data such as your IP address, device type, browser version, pages visited, time spent, and referral sources.
                </p>
              </div>
            </div>
          </div>

          <!-- How We Use Your Information -->
          <div class="space-y-3">
            <h2 class="text-xl sm:text-2xl font-bold text-gray-900 tracking-tight">3. How We Use Your Information</h2>
            <p>We use the collected information for specific, legitimate business purposes:</p>
            <ul class="list-disc pl-5 space-y-2 text-gray-600">
              <li><strong>To respond to your enquiries:</strong> Evaluating your project needs, calculating quotations, and answering your questions.</li>
              <li><strong>To deliver contracted services:</strong> Building your website, managing your SEO campaigns, running ad campaigns, and providing regular progress reports.</li>
              <li><strong>To improve our website:</strong> Understanding how visitors interact with our content so we can make our pages faster, more useful, and easier to navigate.</li>
              <li><strong>To send important updates:</strong> Notifying you about milestones, invoices, security updates, or policy changes directly related to your project.</li>
            </ul>
            <p class="text-sm text-gray-500 italic pt-1">
              Note: We do not send spam. We will only contact you regarding genuine business discussions, project updates, or services you have specifically enquired about.
            </p>
          </div>

          <!-- Sharing & Third Parties -->
          <div class="space-y-3">
            <h2 class="text-xl sm:text-2xl font-bold text-gray-900 tracking-tight">4. Sharing Your Information</h2>
            <p class="font-medium text-gray-900">
              We never sell, rent, or trade your personal information to data brokers or third-party advertisers. Ever.
            </p>
            <p>We may share your data only in the following limited situations:</p>
            <ul class="list-disc pl-5 space-y-2 text-gray-600">
              <li><strong>Trusted Service Providers:</strong> Secure third-party platforms that help us operate our agency (such as email delivery tools, web hosting providers, analytics tools like Google Analytics, and payment processors). These providers are strictly bound to protect your data.</li>
              <li><strong>Ad & Search Platforms (with your consent):</strong> When you hire us to manage paid ad campaigns, campaign account data is set up on official platforms like Google Ads or Meta Ads Manager.</li>
              <li><strong>Legal Requirements:</strong> If required by Indian law, court order, or governmental authorities to comply with applicable legal obligations.</li>
            </ul>
          </div>

          <!-- Cookies & Analytics -->
          <div class="space-y-3">
            <h2 class="text-xl sm:text-2xl font-bold text-gray-900 tracking-tight">5. Cookies and Tracking</h2>
            <p>
              Cookies are small text files placed on your device to help the website run smoothly and measure traffic. We use cookies to:
            </p>
            <ul class="list-disc pl-5 space-y-1.5 text-gray-600">
              <li>Remember your preferences during your visit.</li>
              <li>Analyze website performance and visitor traffic through tools like Google Analytics.</li>
              <li>Ensure our contact and enquiry forms load quickly and prevent spam submissions.</li>
            </ul>
            <p>
              You can choose to disable cookies through your browser settings at any time without losing access to the main content of our website.
            </p>
          </div>

          <!-- Data Security -->
          <div class="space-y-3">
            <h2 class="text-xl sm:text-2xl font-bold text-gray-900 tracking-tight">6. Data Security</h2>
            <p>
              We take the security of your information seriously. Our website uses modern SSL/TLS encryption (HTTPS) to protect data in transit. Access to client project files, credentials, and sensitive assets is restricted to authorized team members on a strict need-to-know basis.
            </p>
            <p>
              While no internet transmission is 100% immune from risks, we follow industry best practices to prevent unauthorized access, alteration, or disclosure.
            </p>
          </div>

          <!-- Your Rights -->
          <div class="space-y-3">
            <h2 class="text-xl sm:text-2xl font-bold text-gray-900 tracking-tight">7. Your Rights Over Your Data</h2>
            <p>You have full control over your personal information. At any time, you can ask us to:</p>
            <ul class="list-disc pl-5 space-y-1.5 text-gray-600">
              <li>Give you a copy of the personal details we have on file for you.</li>
              <li>Update or correct inaccurate or incomplete information.</li>
              <li>Delete your personal details from our active records.</li>
              <li>Stop sending you any non-essential promotional messages.</li>
            </ul>
            <p>
              To exercise any of these rights, simply email us at <a href={`mailto:${siteConfig.contact.email}`} class="text-[#0F5A47] font-semibold underline">{siteConfig.contact.email}</a>. We respond to all requests promptly.
            </p>
          </div>

          <!-- Third-Party External Links -->
          <div class="space-y-3">
            <h2 class="text-xl sm:text-2xl font-bold text-gray-900 tracking-tight">8. Links to Other Websites</h2>
            <p>
              Our website or blog posts may contain links to external websites, articles, or tools. We do not control and are not responsible for the privacy practices or content of third-party websites. We encourage you to review their privacy policies when visiting them.
            </p>
          </div>

          <!-- Updates to this Policy -->
          <div class="space-y-3">
            <h2 class="text-xl sm:text-2xl font-bold text-gray-900 tracking-tight">9. Updates to This Policy</h2>
            <p>
              We may update this Privacy Policy from time to time to reflect changes in our agency operations or applicable legal requirements. The latest version will always be published on this page with the updated date at the top.
            </p>
          </div>

        </div>

      </div>
    </div>
  </section>
</BaseLayout>
