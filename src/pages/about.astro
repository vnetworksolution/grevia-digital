---
import BaseLayout from '../layouts/BaseLayout.astro';
import { seoData, getBreadcrumbSchema } from '../data/seo';
import QuoteCtaSection from '../components/home/QuoteCtaSection.astro';

const breadcrumbSchema = getBreadcrumbSchema([
  { name: "Home", url: "https://greviadigital.com/" },
  { name: "About Us", url: "https://greviadigital.com/about/" }
]);

const coreValues = [
  {
    title: "Transparency",
    desc: "We believe in clear communication and honest recommendations. We explain what we are doing, why it matters and what you can expect from the work.",
    icon: "M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
  },
  {
    title: "Client First",
    desc: "Every business has different goals and challenges. We take time to understand your requirements and focus on solutions that are relevant to your business.",
    icon: "M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
  },
  {
    title: "Continuous Learning",
    desc: "The digital world changes quickly. Search engines, advertising platforms, websites and AI technologies are constantly evolving. We keep learning and adapting so our approach stays current.",
    icon: "M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"
  },
  {
    title: "Practical Thinking",
    desc: "We focus on solutions that are useful and realistic. Instead of following every trend, we look at what can genuinely help your business and its customers.",
    icon: "M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 01-2 2h-4a2 2 0 01-2-2v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"
  },
  {
    title: "Quality Work",
    desc: "We pay attention to the details that make digital work effective, from website experience and SEO structure to advertising campaigns and communication.",
    icon: "M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"
  },
  {
    title: "Long-Term Relationships",
    desc: "We do not want to be just another service provider. We aim to build long-term relationships with our clients through reliable support, consistent communication and continuous improvement.",
    icon: "M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"
  },
  {
    title: "Human + Technology",
    desc: "We use modern tools and AI technology to improve the way we work, while keeping human understanding, creativity and strategy at the centre of every project.",
    icon: "M13 10V3L4 14h7v7l9-11h-7z"
  },
  {
    title: "Keep It Simple",
    desc: "Digital marketing can feel complicated. We believe our job is to make it easier for clients to understand, manage and use their digital presence with confidence.",
    icon: "M5 13l4 4L19 7"
  }
];

const teamMembers = [
  {
    name: "Ronnie",
    role: "Founder",
    designation: "Founder & Digital Marketing Head",
    initials: "R",
    desc: "Leads agency vision, search engine optimization strategy, digital ad funnels, and core technical architecture."
  },
  {
    name: "Priyanka",
    role: "HR",
    designation: "HR & Customer Support",
    initials: "P",
    desc: "Manages client communication, human resources, team coordination, and ongoing customer care."
  }
];
---

<BaseLayout
  title={seoData.about.title}
  description={seoData.about.description}
  canonical={seoData.about.canonical}
  keywords={seoData.about.keywords}
  activePage="about"
  schemaJson={breadcrumbSchema}
>
  <!-- About Hero Section (Deep Luxury Animated Background matching Home Hero) -->
  <section class="relative bg-gradient-to-b from-[#071F19] via-[#092B23] to-[#0D382E] text-white pt-14 pb-20 md:pt-20 md:pb-28 overflow-hidden border-b border-emerald-500/15">
    
    <!-- Subtle High-Tech Radial Background Pattern -->
    <div class="absolute inset-0 bg-[radial-gradient(#16A34A_1px,transparent_1px)] [background-size:28px_28px] opacity-20 pointer-events-none"></div>

    <!-- Ambient Glowing Luxury Lighting Orbs -->
    <div class="absolute top-0 right-1/4 w-[500px] h-[500px] bg-emerald-500/15 rounded-full blur-[140px] pointer-events-none animate-pulse"></div>
    <div class="absolute -bottom-24 left-10 w-[450px] h-[450px] bg-[#EAB308]/10 rounded-full blur-[120px] pointer-events-none"></div>
    <div class="absolute top-1/3 -left-28 w-72 h-72 bg-teal-500/15 rounded-full blur-[100px] pointer-events-none"></div>

    <div class="container-1440 relative z-10">
      <div class="max-w-3xl space-y-6">
        <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full bg-emerald-500/15 border border-emerald-500/30 text-emerald-300 text-xs sm:text-sm font-semibold tracking-wide backdrop-blur-md shadow-[0_0_20px_rgba(16,185,129,0.15)]">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-400"></span>
          </span>
          <span>About Grevia Digital</span>
        </div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-white tracking-[-0.015em] leading-[1.18]">
          We Help Businesses Build Authority, Get Found, & <span class="text-[#EAB308] underline decoration-emerald-400 decoration-4 underline-offset-8 drop-shadow-[0_2px_15px_rgba(234,179,8,0.25)]">Grow Online.</span>
        </h1>
        <p class="text-base sm:text-lg text-gray-200 leading-relaxed font-normal">
          Grevia Digital is a remote-first digital marketing agency based in Siliguri, West Bengal, India, with 8+ years of experience and 100+ projects delivered for startups, local businesses, corporate teams, and service providers across India and worldwide.
        </p>
      </div>
    </div>
  </section>

  <!-- Who We Are Our Story Section -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
        
        <!-- Story Copy (7 Cols) -->
        <div class="lg:col-span-7 space-y-6">
          
          <!-- Single H2 Title with "Our Story" in Green -->
          <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 tracking-tight leading-tight">
            Who We Are? <span class="text-[#0F5A47]">Our Story</span>
          </h2>
          
          <!-- Clean Typography Paragraphs -->
          <div class="space-y-5 text-gray-700 text-base sm:text-lg leading-relaxed font-normal">
            <p>
              Grevia Digital started with a simple idea: Businesses should be able to get reliable digital support without making things complicated. We are a small remote digital marketing team based in Siliguri helping businesses build a stronger and more effective online presence.
            </p>

            <p>
              Over the years, our experience in SEO, Digital Marketing and Website Design has helped us understand how different businesses need different digital solutions. As technology, search engines and customer behaviour continue to change, we keep learning and adapting our approach.
            </p>

            <p>
              Today, Grevia Digital brings together experience, creativity and new AI-powered tools to help businesses move forward in the digital world. We are still a small team, but we believe that staying close to our clients allows us to understand their needs better and provide more personal support.
            </p>

            <p class="font-semibold text-gray-900">
              Our journey is about continuous learning, building meaningful digital solutions and growing together with the businesses we work with.
            </p>
          </div>
        </div>

        <!-- Grevia Digital Overview Block (5 Cols - Matching Connected Digital System Size & Background Animation) -->
        <div class="lg:col-span-5">
          <div class="relative bg-gradient-to-br from-gray-900 via-[#0A3E31] to-[#0F5A47] rounded-3xl p-6 sm:p-8 text-white shadow-2xl border border-gray-800 lg:sticky lg:top-20 overflow-hidden w-full space-y-5 sm:space-y-6">
            
            <!-- Radial background grid overlay -->
            <div class="absolute inset-0 bg-[radial-gradient(#16A34A_1px,transparent_1px)] [background-size:20px_20px] opacity-15 pointer-events-none"></div>

            <!-- Pulsing ambient glowing theme orbs -->
            <div class="absolute -top-20 -right-20 w-64 h-64 bg-[#EAB308]/15 rounded-full blur-3xl pointer-events-none animate-pulse"></div>
            <div class="absolute -bottom-20 -left-20 w-64 h-64 bg-[#16A34A]/20 rounded-full blur-3xl pointer-events-none animate-pulse"></div>

            <div class="relative z-10 space-y-3">
              <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-500/20 text-emerald-300 text-xs font-mono font-bold uppercase tracking-wider border border-emerald-500/30">
                <span class="relative flex h-2 w-2">
                  <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                  <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
                </span>
                <span>Agency Overview</span>
              </div>
              
              <h3 class="text-2xl sm:text-3xl font-bold text-white tracking-tight">
                Grevia Digital Overview
              </h3>
              
              <p class="text-xs sm:text-sm text-gray-300 leading-relaxed flex items-center gap-2">
                <svg class="w-4 h-4 text-emerald-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                </svg>
                <span>Digital Marketing Agency | Siliguri • India • Global</span>
              </p>
            </div>

            <!-- Key Metrics Cards (Clean Proportional Design & Balanced Sizing) -->
            <div class="relative z-10 grid grid-cols-2 gap-3.5">
              
              <!-- Metric 1 -->
              <div class="p-4 rounded-xl bg-white/[0.06] backdrop-blur-md border border-white/10 hover:border-amber-400/40 hover:bg-white/[0.1] transition-all duration-300 space-y-1.5 text-center group/stat">
                <div class="inline-flex items-center justify-center w-8 h-8 rounded-lg bg-[#EAB308]/15 text-[#EAB308] mx-auto border border-[#EAB308]/25 group-hover/stat:scale-105 transition-transform">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                  </svg>
                </div>
                <div class="text-xl sm:text-2xl font-bold text-[#EAB308] tracking-tight leading-none" data-counter-target="8" data-counter-suffix="+ Years">
                  8+ Years
                </div>
                <div class="text-xs font-medium text-gray-200 tracking-wider uppercase">
                  Practical Experience
                </div>
              </div>

              <!-- Metric 2 -->
              <div class="p-4 rounded-xl bg-white/[0.06] backdrop-blur-md border border-white/10 hover:border-amber-400/40 hover:bg-white/[0.1] transition-all duration-300 space-y-1.5 text-center group/stat">
                <div class="inline-flex items-center justify-center w-8 h-8 rounded-lg bg-[#EAB308]/15 text-[#EAB308] mx-auto border border-[#EAB308]/25 group-hover/stat:scale-105 transition-transform">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                  </svg>
                </div>
                <div class="text-xl sm:text-2xl font-bold text-[#EAB308] tracking-tight leading-none" data-counter-target="100" data-counter-suffix="+ Projects">
                  100+ Projects
                </div>
                <div class="text-xs font-medium text-gray-200 tracking-wider uppercase">
                  Work Completed
                </div>
              </div>

            </div>

            <!-- Trust Feature Highlights -->
            <div class="relative z-10 space-y-3.5 pt-4 border-t border-white/10 text-xs sm:text-sm text-gray-200 font-medium">
              <div class="flex items-center gap-3 group/trust-item cursor-default">
                <div class="w-6 h-6 rounded-full bg-emerald-500/20 text-emerald-400 border border-emerald-500/40 flex items-center justify-center font-bold text-xs shrink-0 group-hover/trust-item:bg-emerald-500 group-hover/trust-item:text-white group-hover/trust-item:scale-110 group-hover/trust-item:border-emerald-400 transition-all duration-300 shadow-xs">
                  ✓
                </div>
                <span class="group-hover/trust-item:text-white transition-colors duration-300">Direct communication with experienced strategists</span>
              </div>

              <div class="flex items-center gap-3 group/trust-item cursor-default">
                <div class="w-6 h-6 rounded-full bg-emerald-500/20 text-emerald-400 border border-emerald-500/40 flex items-center justify-center font-bold text-xs shrink-0 group-hover/trust-item:bg-emerald-500 group-hover/trust-item:text-white group-hover/trust-item:scale-110 group-hover/trust-item:border-emerald-400 transition-all duration-300 shadow-xs">
                  ✓
                </div>
                <span class="group-hover/trust-item:text-white transition-colors duration-300">Clear recommendations without confusing agency fluff</span>
              </div>

              <div class="flex items-center gap-3 group/trust-item cursor-default">
                <div class="w-6 h-6 rounded-full bg-emerald-500/20 text-emerald-400 border border-emerald-500/40 flex items-center justify-center font-bold text-xs shrink-0 group-hover/trust-item:bg-emerald-500 group-hover/trust-item:text-white group-hover/trust-item:scale-110 group-hover/trust-item:border-emerald-400 transition-all duration-300 shadow-xs">
                  ✓
                </div>
                <span class="group-hover/trust-item:text-white transition-colors duration-300">Combining human creativity with modern AI workflows</span>
              </div>
            </div>

            <!-- Contact Quick CTA -->
            <div class="relative z-10 pt-2">
              <a
                href="/contact"
                class="w-full inline-flex items-center justify-center px-6 py-4 rounded-xl font-bold text-gray-900 bg-[#EAB308] hover:bg-yellow-400 transition-all shadow-lg hover:shadow-yellow-500/20 text-center text-sm sm:text-base group/btn"
              >
                <span>Work With Grevia Digital</span>
                <svg class="w-4 h-4 ml-2 group-hover/btn:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                </svg>
              </a>
            </div>

          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Our Core Values Section (Final Design 1 - Modern Minimalist Cards) -->
  <section class="py-20 bg-[#F4F6F0] border-y border-gray-200/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <!-- Section Header -->
      <div class="text-center max-w-3xl mx-auto space-y-4">
        <div class="inline-flex items-center justify-center gap-2 px-4 py-1.5 rounded-full bg-[#0F5A47]/10 text-[#0F5A47] text-xs sm:text-sm font-semibold tracking-wide border border-[#0F5A47]/20">
          <span>Foundational Principles</span>
        </div>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-gray-900 tracking-tight leading-tight">
          Our <span class="text-[#0F5A47]">Core Values</span>
        </h2>
        <p class="text-gray-700 text-base sm:text-lg leading-relaxed font-normal">
          Our values shape how we work, how we communicate and how we build relationships with our clients. We believe good digital work starts with good principles.
        </p>
      </div>

      <!-- 8 Core Values Cards Grid (Design 1 Final - Clean & Minimalist) -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {coreValues.map((val) => (
          <div class="bg-white p-7 rounded-3xl border border-gray-200/90 shadow-sm hover:shadow-xl hover:border-[#0F5A47] transition-all duration-300 flex flex-col justify-between space-y-4 group">
            
            <div class="space-y-4">
              <!-- Icon Container -->
              <div class="w-12 h-12 rounded-2xl bg-[#0F5A47]/10 text-[#0F5A47] flex items-center justify-center font-bold group-hover:bg-[#0F5A47] group-hover:text-white transition-all duration-300 border border-[#0F5A47]/20">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={val.icon}></path>
                </svg>
              </div>

              <!-- Title -->
              <h3 class="text-xl font-bold text-gray-900 group-hover:text-[#0F5A47] transition-colors">
                {val.title}
              </h3>

              <!-- Description -->
              <p class="text-sm sm:text-[15px] text-gray-600 leading-relaxed font-normal">
                {val.desc}
              </p>
            </div>

          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- MEET WITH US TEAM SECTION (White Background, Modern Open Layout with Profile Icons & No Role Tags) -->
  <section class="py-20 bg-white border-b border-gray-200/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-14">
      
      <!-- Section Header -->
      <div class="text-center max-w-3xl mx-auto space-y-4">
        <div class="inline-flex items-center justify-center gap-2 px-4 py-1.5 rounded-full bg-[#0F5A47]/10 text-[#0F5A47] text-xs sm:text-sm font-semibold tracking-wide border border-[#0F5A47]/20">
          <span>Leadership Team</span>
        </div>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-gray-900 tracking-tight leading-tight">
          Meet <span class="text-[#0F5A47]">with Us</span>
        </h2>
        <p class="text-gray-600 text-base sm:text-lg leading-relaxed font-normal">
          The dedicated individuals leading strategy, digital marketing, human resources, and customer support at Grevia Digital.
        </p>
      </div>

      <!-- 2 Person Team Layout (Open Clean Layout with NO block background/card box) -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 lg:gap-16 max-w-5xl mx-auto">
        {teamMembers.map((member) => (
          <div class="flex flex-col sm:flex-row items-center sm:items-start gap-6 group">
            
            <!-- Person Profile Vector Icon Container -->
            <div class="w-20 h-20 sm:w-24 sm:h-24 rounded-2xl bg-[#0F5A47]/10 text-[#0F5A47] flex items-center justify-center shrink-0 border border-[#0F5A47]/20 group-hover:bg-[#0F5A47] group-hover:text-white transition-all duration-300 shadow-sm">
              <svg class="w-10 h-10 sm:w-12 sm:h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
              </svg>
            </div>

            <!-- Member Details (Clean Open Typography, No Block Box, No Founder/HR Badge) -->
            <div class="space-y-2.5 text-center sm:text-left flex-1">
              <h3 class="text-2xl sm:text-3xl font-bold text-gray-900 group-hover:text-[#0F5A47] transition-colors leading-tight">
                {member.name}
              </h3>

              <p class="text-base font-semibold text-[#0F5A47] flex items-center justify-center sm:justify-start gap-2">
                <span class="w-2 h-2 rounded-full bg-[#EAB308]"></span>
                <span>{member.designation}</span>
              </p>

              <p class="text-sm sm:text-base text-gray-600 leading-relaxed font-normal pt-2 border-t border-gray-100">
                {member.desc}
              </p>
            </div>

          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- CTA Banner -->
  <QuoteCtaSection />
</BaseLayout>

<script>
  function initAboutCounters() {
    const counterElements = document.querySelectorAll('[data-counter-target]');
    if (!counterElements.length) return;

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const el = entry.target as HTMLElement;
          const targetNum = parseInt(el.getAttribute('data-counter-target') || '0', 10);
          const suffix = el.getAttribute('data-counter-suffix') || '+';
          const duration = 2500; // 2.5 seconds
          let startTime: number | null = null;

          function animateCounter(timestamp: number) {
            if (!startTime) startTime = timestamp;
            const elapsed = timestamp - startTime;
            const progress = Math.min(elapsed / duration, 1);
            const easeProgress = 1 - Math.pow(1 - progress, 2);
            const current = Math.floor(easeProgress * targetNum);

            el.textContent = current + suffix;

            if (progress < 1) {
              requestAnimationFrame(animateCounter);
            } else {
              el.textContent = targetNum + suffix;
            }
          }

          requestAnimationFrame(animateCounter);
          observer.unobserve(el);
        }
      });
    }, { threshold: 0.1 });

    counterElements.forEach((el) => observer.observe(el));
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAboutCounters);
  } else {
    initAboutCounters();
  }
  document.addEventListener('astro:page-load', initAboutCounters);
</script>
